{
  "name": "yallaflow",
  "version": "1.1.0",
  "description": "AI-agnostic engineering governance layer for coding agents: durable project memory, adaptive workflows, and evidence-backed delivery.",
  "keywords": [
    "ai",
    "coding-agent",
    "claude-code",
    "codex",
    "agents",
    "project-memory",
    "engineering-governance",
    "spec-driven-development",
    "workflow",
    "cli",
    "developer-tools"
  ],
  "homepage": "https://github.com/engmohamedamer/yallaflow#readme",
  "bugs": {
    "url": "https://github.com/engmohamedamer/yallaflow/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/engmohamedamer/yallaflow.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "yallaflow": "src/cli.js"
  },
  "files": [
    "src",
    "resources",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check:syntax": "find src test test-support -name '*.js' -print0 | xargs -0 -n1 node --check",
    "check": "npm run check:syntax && npm test"
  },
  "engines": {
    "node": ">=20.16.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.10",
    "officeparser": "5.2.2",
    "pdfjs-dist": "5.4.624",
    "yauzl": "^3.1.3"
  },
  "overrides": {
    "pdfjs-dist": "5.4.624"
  }
}
