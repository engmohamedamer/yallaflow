          <p class="small tw:mt-3"><b>${A('YallaFlow هيعمل بالظبط:', 'YallaFlow will make exactly these changes:')}</b></p>
          <ul class="fpick-plan">${p.plan.filter((x) => x.op !== 'unchanged').map((x) => `<li><span class="fpick-op ${x.op === 'create' ? 'add' : 'mod'}" aria-hidden="true">${opSign[x.op]}</span><span class="ltr">${esc(x.path)}</span><span class="tiny muted">${esc(notes[x.path] || opText[x.op])}${notes[x.path] && x.op !== 'create' ? ` · ${esc(opText[x.op])}` : ''}</span></li>`).join('')}</ul>
          <p class="tiny muted tw:mt-2">${!p.git && !p.gitAbove ? A('مفيش كود تطبيق هيتغيّر، ومفيش commit، ومفيش تغيير في Git إلا لو اخترت «git init» تحت.', 'No application code changes, no commit, and no Git changes unless you tick "git init" below.') : A('مفيش كود تطبيق هيتغيّر، ومفيش commit، ومفيش تغيير في Git.', 'No application code changes, no commit, no Git changes.')}${existing ? ` ${A('لا يُشغَّل أي أمر من أوامر المشروع.', 'No project command is run.')} ${A('بعدها وكيلك بيجهّز فهم للمشروع وإنت توافق عليه.', 'Next, your agent prepares a project understanding for you to approve.')}` : ''}</p>
          ${!p.git && !p.gitAbove ? `<label class="small fpick-git"><input type="checkbox" data-folder-gitinit ${folder.gitInit ? 'checked' : ''}> <span><b>${A('اعمل Git repository في الفولدر ده', 'Also create a Git repository in this folder')}</b> <span class="ltr tiny muted">(git init)</span> <span class="tiny muted">· ${A('اختياري', 'optional')}</span><br><span class="tiny muted">${A('الفولدر ده مفيهوش Git. بيتعمل repository فاضي بس: من غير commit ولا remote، وملفاتك زي ما هي. Git بيخلّيك ترجع في أي تغيير، ومطلوب لشغل الفريق والـ lanes.', 'This folder has no Git. Only an empty repository is created: no commit, no remote, and your files stay as they are. Git lets you undo any change, and team work and lanes need it.')}</span></span></label>` : ''}
          ${existing ? `<label class="small fpick-first">${A('ما أول شيء تريد عمله في هذا المشروع؟', 'What do you want to do first in this project?')} <span class="tiny muted">· ${A('اختياري', 'optional')}</span><input type="text" data-folder-first maxlength="300" value="${esc(folder.first ?? '')}" placeholder="${A('مثال: إضافة الدفع الإلكتروني للحجوزات', 'Example: add online payment for bookings')}" autocomplete="off"><span class="tiny muted">${A('يُعطى لوكيلك مع طلب فهم المشروع، ليتعمق في الأجزاء المتعلقة به. لا يُنشأ أي عمل تلقائيًا.', 'It goes to your agent with the project-understanding request, so it looks deeper where it matters. No work is created automatically.')}</span></label>` : ''}
          <label class="small tw:mt-3 tw:flex tw:items-center tw:gap-2"><input type="checkbox" data-folder-ack ${folder.ack ? 'checked' : ''}> ${A('راجعت التغييرات دي', 'I reviewed these changes')}</label>`}
          ${folder.previewError ? `<p class="small tw:mt-2 tw:text-clay" role="alert" dir="auto" style="white-space:pre-wrap">${esc(folder.previewError)}</p>` : ''}
          <div class="row tw:mt-4"><button type="button" class="btn ghost" data-folder-back>${A('رجوع', 'Back')}</button><span class="grow"></span>${p.problems.length ? '' : `<button type="button" class="btn go" data-folder-connect ${folder.ack && !folder.previewBusy ? '' : 'disabled'}>${folder.previewBusy ? A('بيجهّز…', 'Setting up…') : existing ? A('جهّز YallaFlow', 'Set up YallaFlow') : A('ابدأ المشروع', 'Start the project')}</button>`}</div></section>`;
      }
      function renderFolder() {
        const d = document.getElementById('folderdlg');
        if (!d || !folder) return;
        const x = folder.data;
        const title = folder.mode === 'parent' ? A('فين نعمل المشروع الجديد؟', 'Where should the new project go?') : A('اختار فولدر المشروع', 'Choose the project folder');
        d.setAttribute('aria-labelledby', 'fpick-h');
        const head = `<div class="row"><h2 id="fpick-h" class="grow tw:text-lg tw:font-semibold">${title}</h2><button type="button" class="ibtn" data-folder-close aria-label="${A('اقفل', 'Close')}">✕</button></div>`;
        if (folder.preview) { d.innerHTML = head + previewPanel(); d.querySelector('[data-folder-ack], [data-folder-back]')?.focus(); return; }
        const recents = [...new Set([...(folder.mode === 'existing' ? projects.map((p) => p.root) : []), ...recentFolders()])].filter((p) => x && (x.roots ?? [{ path: x.home }]).some((r) => p.startsWith(r.path)) && p !== x.path).slice(0, 6);
        const label = (p) => projects.find((q) => q.root === p)?.name ?? lastName(p);
        const rows = x?.folders ?? [];
        d.innerHTML = `${head}
          ${folder.editPath ? `<form class="fpick-pathform" data-folder-pathform><label class="tw:sr-only" for="fpick-path">${A('المسار', 'Path')}</label><input id="fpick-path" class="ltr" name="path" value="${esc(tildePath(x?.path))}" spellcheck="false" autocomplete="off" placeholder="~/code/my-project"><button type="submit" class="btn sm go">${A('روح', 'Go')}</button><button type="button" class="btn sm ghost" data-folder-editpath="off">${A('إلغاء', 'Cancel')}</button></form>`
            : `<div class="fpick-bar">${x?.parent ? `<button type="button" class="ibtn fpick-up" data-folder-go="${esc(x.parent)}" aria-label="${A('الفولدر الأعلى', 'Up one folder')}" title="${A('الفولدر الأعلى (Backspace)', 'Up one folder (Backspace)')}">↑</button>` : ''}${crumbs(x)}<span class="grow"></span>${x ? `<button type="button" class="ibtn fpick-edit" data-folder-editpath="on" aria-label="${A('اكتب المسار', 'Type a path')}" title="${A('اكتب المسار بنفسك', 'Type a path yourself')}">✎</button>` : ''}</div>`}
          ${folderRoots(x)}${recents.length ? `<div class="fpick-recent"><span class="tiny muted">${A('أخيراً:', 'Recent:')}</span>${recents.map((p) => `<button type="button" class="fchip" data-folder-go="${esc(p)}" title="${esc(tildePath(p))}">${esc(label(p))}</button>`).join('')}</div>` : ''}
          <div class="fpick-tools"><input type="search" data-folder-filter placeholder="${A('دوّر في الفولدرات…', 'Filter folders…')}" aria-label="${A('دوّر في الفولدرات', 'Filter folders')}" autocomplete="off">${folder.mode === 'parent' && x ? (folder.creating ? `<form class="fpick-new" data-folder-newform><input name="name" maxlength="80" placeholder="${A('اسم الفولدر', 'Folder name')}" aria-label="${A('اسم الفولدر الجديد', 'New folder name')}" required><button type="submit" class="btn sm go">${A('اعمل', 'Create')}</button><button type="button" class="btn sm ghost" data-folder-newcancel>${A('إلغاء', 'Cancel')}</button></form>` : `<button type="button" class="btn sm" data-folder-new>＋ ${A('فولدر جديد', 'New folder')}</button>`) : ''}</div>
          ${folder.error ? `<p class="small tw:text-clay" role="alert" dir="auto">${esc(folder.error)}</p>` : ''}
          ${folder.busy ? `<p class="muted small fpick-list">${A('بيقرا…', 'Reading…')}</p>` : x ? `<ul class="fpick-list" role="list" aria-label="${A('الفولدرات', 'Folders')}">${rows.map(folderRow).join('') || `<li class="muted small fpick-empty">${A('مفيش فولدرات هنا.', 'No folders here.')}</li>`}<li class="muted small fpick-empty" data-folder-nomatch hidden>${A('مفيش فولدر بالاسم ده.', 'No folder matches.')}</li></ul>${x.truncated ? `<p class="tiny muted">${A('أول 500 فولدر بس.', 'First 500 folders only.')}</p>` : ''}` : ''}
          ${folderFooter(x)}
          <p class="tiny muted fpick-hint">${A('ضغطة بتختار الفولدر · دبل كليك أو Enter بيدخله · Backspace بيرجع للأعلى. المتاح: فولدر البيت والأقراص المحلية؛ فولدرات الشبكة والمخفية مابتظهرش.', 'Click selects a folder · double-click or Enter opens it · Backspace goes up. Your home folder and local drives; network and hidden folders are not shown.')}</p>`;
      }
      // Filtering hides rows in place (no redraw, so typing keeps its focus and caret).
      function onFolderInput(e) {
        if (e.target.matches('[data-folder-first]')) { if (folder) folder.first = e.target.value; return; }
        if (!e.target.matches('[data-folder-filter]')) return;
        const q = e.target.value.trim().toLowerCase();
        let shown = 0;
        for (const li of document.querySelectorAll('#folderdlg .fpick-list li[data-name]')) { const hit = !q || li.dataset.name.includes(q); li.hidden = !hit; if (hit) shown++; }
        const none = document.querySelector('#folderdlg [data-folder-nomatch]');
        if (none) none.hidden = shown > 0 || !q;
      }
      function onFolderKey(e) {
        const d = document.getElementById('folderdlg');
        if (!folder || folder.preview) return;
        const rows = [...d.querySelectorAll('.fpick-list li:not([hidden]) .fpick-row')];
        const inField = e.target.matches('input');
        const at = rows.indexOf(e.target);
        // PF-0139: the arrows move the selection; Enter (or the forward arrow) opens the folder.
        const move = (row) => { if (row) { row.focus(); pickFolder(row.dataset.folderPick); } };
        if (e.key === 'ArrowDown' && (at >= 0 || e.target.matches('[data-folder-filter]'))) { e.preventDefault(); move(rows[Math.min(at + 1, rows.length - 1)]); return; }
        if (e.key === 'ArrowUp' && !e.altKey && at >= 0) { e.preventDefault(); if (at === 0) d.querySelector('[data-folder-filter]')?.focus(); else move(rows[at - 1]); return; }
        if (e.key === 'Enter' && e.target.matches('[data-folder-filter]')) { e.preventDefault(); if (rows[0]) openFolder(folder.mode, rows[0].dataset.folderPick); return; }
        const forward = lang === 'ar' ? 'ArrowLeft' : 'ArrowRight';
        if (at >= 0 && (e.key === 'Enter' || e.key === forward)) { e.preventDefault(); openFolder(folder.mode, rows[at].dataset.folderPick); return; }
        if (at >= 0 && (e.key === 'ArrowLeft' || e.key === 'ArrowRight')) { e.preventDefault(); if (folder.data?.parent) openFolder(folder.mode, folder.data.parent); return; }
        if ((e.key === 'Backspace' && !inField) || (e.key === 'ArrowUp' && e.altKey)) { e.preventDefault(); if (folder.data?.parent) openFolder(folder.mode, folder.data.parent); return; }
        // Typing on a row starts filtering.
        if (!inField && e.key.length === 1 && !e.ctrlKey && !e.metaKey && !e.altKey && /\S/.test(e.key)) { const f = d.querySelector('[data-folder-filter]'); if (f) { f.focus(); f.value += e.key; onFolderInput({ target: f }); e.preventDefault(); } }
      }
      // A typed path: "~" means the home folder; the server checks everything else.
      function typedPath(value) {
        const v = String(value ?? '').trim();
        const home = folder?.data?.home ?? '';
        if (v === '~') return home;
        if (/^~[\\/]/.test(v)) return `${home}${folderSep()}${v.slice(2)}`;
        return v;
      }
      async function previewFolder() {
        const x = folderTarget();
        if (!x) return;
        folder.previewBusy = true;
        try { folder.preview = await api(`/api/fs/connect-preview?path=${encodeURIComponent(x.path)}`); folder.previewError = null; } catch (e) { folder.error = folderWhy(e); }
        folder.previewBusy = false; folder.ack = false; folder.gitInit = false; renderFolder();
      }
      async function connectFolder() {
        const p = folder?.preview;
        if (!p || !folder.ack) return;
        const wantGit = Boolean(folder.gitInit) && !p.git && !p.gitAbove;
        folder.previewBusy = true; folder.previewError = null; renderFolder();
        try {
          const reg = await post('/api/projects/connect', JSON.stringify({ root: p.path, planHash: p.planHash, confirm: true }), { 'Content-Type': 'application/json' });
          // PF-0139: the developer ticked "git init" in the preview — the console's own confirmed
          // action, on the project just connected. A refusal never undoes the connect.
          let gitNote = '';
          if (wantGit) {
            try { await post(`/api/p/${reg.id}/git/init`, JSON.stringify({ confirm: true }), { 'Content-Type': 'application/json' }); gitNote = A(' · Git repository اتعمل', ' · Git repository created'); }
            catch (e) { gitNote = A(` · Git ماتعملش: ${why(e)}`, ` · Git was not created: ${why(e)}`); }
          }
          rememberFolder(parentPath(p.path));
          // PF-0149: the first request stays in this browser only, until the agent is asked.
          const first = String(folder.first ?? '').replace(/\s+/g, ' ').trim().slice(0, 300);
          if (first && p.kind === 'existing-code') store.set(firstRequestKey(reg.id), first);
          document.getElementById('folderdlg')?.close();
          await reloadProjects();
          toast(esc(A(`«${p.name}» بقى مشروع YallaFlow ✓`, `“${p.name}” is now a YallaFlow project ✓`) + gitNote));
          await switchProject(reg.id, 'map');
        } catch (e) {
          if (e.data?.preview) { folder.preview = e.data.preview; folder.ack = false; }
          folder.previewBusy = false; folder.previewError = why(e); renderFolder();
        }
      }
      async function newFolder(form) {
        const name = form.name.value.trim();
        if (!name || !folder?.data) return;
        try {
          const data = await post('/api/fs/mkdir', JSON.stringify({ parent: folder.data.path, name }), { 'Content-Type': 'application/json' });
          folder.data = data; folder.sel = null; folder.creating = false; folder.error = null; renderFolder();
          document.querySelector('#folderdlg [data-folder-choose]')?.focus();
        } catch (e) { folder.error = why(e); renderFolder(); document.querySelector('#folderdlg [data-folder-newform] input')?.focus(); }
      }
      async function chooseFolder(mode = null) {
        const x = folderTarget();
        if (!x) return;
        if (folder.mode === 'parent') {
          wizForm().parent = x.path;
          rememberFolder(x.path);
          const typed = document.querySelector('[data-wiz-step="1"] input[name="parent"]');
          if (typed) { typed.value = x.path; typed.defaultValue = x.path; }
          document.getElementById('folderdlg')?.close();
          folder = null; render(); return;
        }
        folder.busy = true; renderFolder();
        try {
          const reg = await post('/api/projects', JSON.stringify({ root: x.path, ...(mode === 'monitor' ? { mode } : {}) }), { 'Content-Type': 'application/json' });
          rememberFolder(parentPath(x.path));
          document.getElementById('folderdlg')?.close();
          folder = null;
          await reloadProjects();
          // PF-0069: a project without a finished setup opens on its first-time setup.
          // PF-0161: a monitored project has no setup: it opens on its work.
          let firstTime = false;
          if (reg.mode !== 'monitor') { try { firstTime = Boolean((await api(`/api/p/${reg.id}/setup`)).pending); } catch { firstTime = false; } }
          await switchProject(reg.id, firstTime ? 'settings' : 'overview');
        } catch (e) { folder.busy = false; folder.error = e.message; renderFolder(); }
      }
    
      // ---------- agents (1.4.0, PF-0057): off / unavailable / on, enabled for this run ----------
      let agentsCanEnable = false;
      let agentsClaudeAvailable = false;
      let agentInfo = null;
      async function loadAgentInfo() { try { agentInfo = await api('/api/agents'); agentsCanEnable = agentInfo.canEnable; } catch { agentInfo = null; } }
      // Enabling agents for this run (PF-0059/PF-0060): Codex, and Claude Code only if the
      // developer ticks its separate, unchecked, clearly experimental choice.
      function enableAgents() {
        let d = document.getElementById('agentsdlg');
        if (!d) { d = document.createElement('dialog'); d.id = 'agentsdlg'; d.className = 'panel'; document.body.appendChild(d); }
        const claudeChoice = agentsClaudeAvailable ? `<label class="small optin"><input type="checkbox" name="claude"> <b>${A('اسمح كمان بـ Claude Code (تجريبي)', 'Also allow Claude Code (experimental)')}</b></label>
          <ul class="tiny muted"><li>${A('بتشغّل Claude Code بنفسك في الترمينال بالأمر اللي هيظهر، وبعدها الشات بيشتغل في الاتجاهين.', 'You start Claude Code yourself in a terminal with the command shown; then the chat works both ways.')}</li><li>${A('بيحتاج --dangerously-load-development-channels، وClaude هيعرض تحذير قناة تطوير.', 'It needs --dangerously-load-development-channels, and Claude shows a development-channel warning.')}</li><li>${A('مفيش «وقّف» من الكونسول، والردود بتوصل كرسالة كاملة.', 'No Stop from the console; replies arrive as whole messages.')}</li><li>${A('رد Anthropic المكتوب على توزيع القناة لسه مستنيينه.', "Anthropic's written answer on distributing the channel is still pending.")}</li><li>${A('بيكتب ملف اتصال في .yallaflow/local (متجاهَل من git) في كل مشروع مفتوح.', 'It writes a connection file in .yallaflow/local (ignored by Git) in each open project.')}</li></ul>` : '';
        d.innerHTML = `<form method="dialog" data-agents-form class="wizform"><h2 style="font-size:18px">${A('تفعيل الوكلاء للجلسة دي', 'Enable agents for this session')}</h2>
          <p class="small">${A('Codex بيشتغل باشتراك ChatGPT بتاعك، من غير مفاتيح API. مفيش جلسة بتبدأ ومفيش شغلانة بتتفعّل لوحدها. ده بيخلص لما الكونسول يقفل.', 'Codex runs on your ChatGPT subscription, never API keys. No session starts and no work item is activated on its own. This ends when the console stops.')}</p>
          ${claudeChoice}
          <div class="row"><button type="button" class="btn ghost" data-agents-cancel>${A('إلغاء', 'Cancel')}</button><span class="grow"></span><button class="btn go" type="submit">${A('فعّل', 'Enable')}</button></div></form>`;
        d.showModal();
        d.querySelector('button[type="submit"]').focus();
      }
      async function confirmAgents(form) {
        const claude = Boolean(form.querySelector('input[name="claude"]')?.checked);
        document.getElementById('agentsdlg')?.close();
        try {
          const result = await post('/api/agents/enable', JSON.stringify({ confirm: true, ...(claude ? { claude: true } : {}) }), { 'Content-Type': 'application/json' });
          if (claude && !result?.claude) toast(esc(A('الوكلاء اتفعّلوا، بس Claude Code مااتفعّلش في الجلسة دي (اتفعّلت قبل كده من غيره). أعد تشغيل الكونسول علشان تختاره.', 'Agents are on, but Claude Code was not turned on for this session (it was enabled earlier without it). Restart the console to choose it.')));
          agentsOn = true; agentsCanEnable = false;
          await loadAgentInfo();
          if (chatCtx()) await loadAgent();
        } catch (e) { toast(esc(e.message)); }
        render();
      }
      // The work item page while agents are off: say so plainly, and how to turn them on.
      function agentOffPanel(it) {
        const explain = `<p class="tiny muted">${A('«فعّل الشغلانة» بيخليها الشغلانة النشطة في YallaFlow. «ابدأ جلسة» بيفتح Codex عليها. ولا واحدة فيهم بتحصل لوحدها.', 'Activating makes this the active work item in YallaFlow. Starting a session opens Codex on it. Neither happens on its own.')}</p>`;
        if (readOnly) return `<section class="panel agent" id="agent"><h2>${A('الوكيل', 'Agent')}</h2><p class="small">${monitorProject() ? A('هذا المشروع للمتابعة فقط، فلا يعمل معه وكيل من الكونسول. حوّله إلى إدارة لتستخدم وكيلاً.', 'This project is monitor only, so no agent works on it from the console. Switch it to Manage to use an agent.') : A('الكونسول ده للقراءة بس، فمساحة الوكيل مقفولة.', 'This console is read-only, so the Agent Workspace is off.')}</p></section>`;
        const codex = agentInfo?.codex;
        const status = codex && !codex.ready ? `<p class="small">${A('Codex مش جاهز على الجهاز ده:', 'Codex is not ready on this machine:')}</p><ul class="aprob">${codex.problems.map((p) => `<li>${esc(p)}</li>`).join('')}</ul>` : '';
        return `<section class="panel agent" id="agent"><div class="ahead"><h2>${A('الوكيل', 'Agent')}</h2><span class="grow"></span><span class="chip todo">${A('مقفول', 'off')}</span></div>
          <p class="small">${it.project ? A('اسأل الوكيل عن المشروع من هنا. مساحة الوكيل مقفولة في الكونسول ده لحد ما تفعّلها.', 'Ask the agent about the project from here. The Agent Workspace is off in this console until you enable it.') : A(`اشتغل على ${it.id} مع Codex من هنا. مساحة الوكيل مقفولة في الكونسول ده لحد ما تفعّلها.`, `Work on ${it.id} with Codex from here. The Agent Workspace is off in this console until you enable it.`)}</p>${status}
          ${agentsCanEnable ? `<button class="btn go sm" data-agents-enable>${A('فعّل الوكلاء للجلسة دي', 'Enable agents for this session')}</button>` : ''}${explain}</section>`;
      }
    
      // ---------- projects ----------
      let overview = null; // [{ project, snap | error }]
      async function loadOverview() {
        overview = await Promise.all(projects.map(async (project) => {
          // PF-0082: each card's memory health comes from the project's own overview (read-only).
          // A failure there leaves the card as it was.
          const health = api(`/api/p/${project.id}/overview`).then((o) => ({ memory: o.memory ?? null, understanding: o.understanding?.state ?? null, baselineId: o.understanding?.baselineId ?? null, kind: o.project?.kind ?? null, origin: o.project?.origin ?? null })).catch(() => null);
          try { return { project, snap: await api(`/api/p/${project.id}/snapshot`), health: await health }; } catch (e) { return { project, error: e.message, health: await health }; }
        }));
      }
      // PF-0081: take a project off the console (and the saved list). Its files stay as they are.
      let removing = null; // { id?, root?, name }
      function askRemoveProject(target) {
        removing = target;
        let d = document.getElementById('rmprojdlg');
        if (!d) { d = document.createElement('dialog'); d.id = 'rmprojdlg'; d.className = 'panel'; document.body.appendChild(d); }
        d.innerHTML = `<form method="dialog" data-remove-project-form class="wizform"><h2 style="font-size:18px">${A('تشيل المشروع من الكونسول؟', 'Remove this project from the console?')}</h2>
          <p class="small"><b dir="auto">${esc(target.name)}</b></p>
          <p class="small">${A('هيختفي من قايمة المشاريع هنا ومن القايمة المحفوظة. ملفات المشروع وسجلات .yallaflow بتاعته مش هتتلمس، وتقدر ترجّعه بعدين من «ضيف مشروع موجود».', 'It leaves the project list here and the saved list. The project\'s files and its .yallaflow records are not touched; you can add it back later with Add an existing project.')}</p>
          ${target.id ? `<p class="tiny muted">${A('لو فيه وكيل شغّال في المشروع ده، وقّفه الأول. لو الكونسول بيشتغل من جوه فولدر المشروع، هيرجع يظهر المرة الجاية.', 'If an agent is running in this project, end it first. If you start the console from inside this project folder, it shows again next time.')}</p>` : ''}
          <div class="row"><button type="button" class="btn ghost" data-remove-project-cancel>${A('إلغاء', 'Cancel')}</button><span class="grow"></span><button class="btn go" type="submit">${A('شيله', 'Remove')}</button></div></form>`;
        d.showModal();
        d.querySelector('[data-remove-project-cancel]').focus();
      }
      async function confirmRemoveProject() {
        const target = removing;
        removing = null;
        document.getElementById('rmprojdlg')?.close();
        if (!target) return;
        try {
          await post('/api/projects/remove', JSON.stringify(target.id ? { id: target.id } : { root: target.root }), { 'Content-Type': 'application/json' });
          await reloadProjects();
          toast(esc(A(`${target.name} اتشال من الكونسول. ملفاته زي ما هي.`, `${target.name} was removed from the console. Its files are unchanged.`)));
          await leaveRemovedProject();
          await loadOverview();
        } catch (e) {
          toast(esc(e.code === 'SESSION_ACTIVE' ? A('فيه وكيل شغّال في المشروع ده. وقّف الجلسة الأول وبعدين شيله.', 'An agent session is running in this project. End it first, then remove the project.') : e.message));
        }
        render();
      }
      // The open project was removed (here or in another tab): move to the next one, if any.
      async function leaveRemovedProject() {
        if (projects.some((p) => p.id === pid)) return;
        pid = projects[0]?.id ?? null;
        store.set('project', pid);
        snap = null; detail = null; team = null; digest = null; projectOverview = null; runtime = null;
        await load();
        if (pid) await buildDigest();
      }
      // PF-0082 / PF-0169: the card's readiness and memory line, from the project's own records —
      // kept apart from its execution state. Counts that need care link to the project's Overview.
      function cardHealth(project, h) {
        if (!h) return '';
        const parts = [];
        const gate = h.understanding && !['PROJECT_UNDERSTANDING_ESTABLISHED', 'GREENFIELD_UNDERSTANDING_FROM_INTENT'].includes(h.understanding) ? (UNDERSTANDING_TEXT[h.understanding] ?? UNDERSTANDING_TEXT.PROJECT_UNDERSTANDING_UNAVAILABLE) : null;
        if (gate) parts.push(`<span class="chip ${gate.tone}" data-understanding-chip="${esc(h.understanding)}"><i></i>${L(gate.title)}</span>`);
        const m = h.memory;
        if (!m?.available) parts.push(`<span class="muted">${A('الذاكرة مش مقروءة.', 'Memory could not be read.')}</span>`);
        else if (!m.current) {
          // PF-0084: what was chosen in the wizard, until the first work item records it in memory.
          const env = { docker: 'Docker', local: A('أدوات على الجهاز', 'local tools') }[h.origin?.environment];
          const chosen = h.origin?.createdBy === 'yallaflow new' ? [(h.origin.stack ?? []).join(' · ') || A('مشروع فاضي', 'empty project'), env].filter(Boolean).join(' · ') : '';
          if (!gate) parts.push(`<span class="muted">${A('فاضية لسه — بتتملى مع الشغل.', 'empty so far — it fills as work is recorded.')}</span>${chosen ? `<span class="muted pcard-chosen">${A('اتختار وقت الإنشاء:', 'Chosen at creation:')} <bdi>${esc(chosen)}</bdi></span>` : ''}`);
        } else {
          parts.push(`<span>${A(`${m.current} معلومة`, `${m.current} facts`)}</span>`);
          const stale = (m.mayBeStale ?? 0) + (m.staleEvidence ?? 0);
          const care = [stale ? A(`${stale} محتاجة مراجعة`, `${stale} to recheck`) : '', m.disputed ? A(`${m.disputed} عليها خلاف`, `${m.disputed} disputed`) : '', m.unresolved ? A(`${m.unresolved} مش محسومة`, `${m.unresolved} unresolved`) : ''].filter(Boolean);
          const why = A('«محتاجة مراجعة»: الملفات اللي بتثبتها اتغيّرت، والوكيل بيراجعها لما الشغل يلمسها. «مش محسومة»: معلومة لسه من غير دليل كفاية.', '“To recheck”: the files behind them changed; the agent rechecks them when work touches them. “Unresolved”: knowledge without enough evidence yet.');
          parts.push(care.length
            ? `<button type="button" class="linkbtn pcard-care" data-open-project="${esc(project.id)}" data-open-view="overview" title="${esc(why)}">${care.join(' · ')} ${fwd()}</button>`
            : `<span class="muted">✓ ${A('مفيش حاجة محتاجة مراجعة', 'nothing needs care')}</span>`);
        }
        return `<div class="pcard-health tiny"><b>${A('ذاكرة المشروع', 'Project memory')}</b>${parts.join('')}</div>`;
      }
      // PF-0162: the first screen asks what the developer wants to do. Create and Manage work with
      // an AI agent, so the state of the agents on this machine is shown with them, and its setup
      // opens in place. Monitor needs no agent. The intent is saved with the preferences.
      let welcomeSetup = false;
      let folderIntent = null; // 'manage' | 'monitor': what the folder chooser was opened for
      function welcomeAgentLine() {
        if (!machineInfo) return `<p class="small muted" data-welcome-agent="checking">${A('جارٍ فحص الوكلاء على هذا الجهاز…', 'Checking the agents on this machine…')}</p>`;
        const r = machineInfo.data?.readiness;
        if (!r) return '';
        const names = { codex: 'Codex', claude: 'Claude Code' };
        if (r.level === 'ready') {
          const usual = r.preferredAgent?.ready ? r.preferredAgent.id : r.readyAgents[0];
          return `<p class="small" data-welcome-agent="ready"><span class="chip done"><i></i>${A('الوكيل جاهز', 'Agent ready')}</span> ${A(`${names[usual]} جاهز على هذا الجهاز، فالإنشاء والإدارة يعملان مباشرة.`, `${names[usual]} is ready on this machine, so Create and Manage work right away.`)}</p>`;
        }
        return `<div data-welcome-agent="needs-setup"><p class="small"><span class="chip wait">${A('الوكيل يحتاج إعداداً', 'Agent needs setup')}</span> ${A('الإنشاء والإدارة يعملان مع وكيل ذكاء اصطناعي باشتراكك أنت (بدون مفاتيح API). جهّزه مرة واحدة على هذا الجهاز؛ المتابعة فقط لا تحتاجه.', 'Create and Manage work with an AI agent on your own subscription (never API keys). Set it up once on this machine; Monitor only does not need it.')} ${welcomeSetup ? '' : `<button type="button" class="btn sm" data-welcome-setup>${A('جهّز الوكيل', 'Set up the agent')}</button>`}</p>${welcomeSetup ? agentSetupCard() : ''}</div>`;
      }
      // PF-0163: an unfinished new project (this browser's draft) is one click away.
      function unfinishedCreation() {
        if (readOnly) return '';
        const draft = wizDraft();
        if (!draft?.form?.name) return '';
        return `<section class="wsbanner note" data-unfinished-new><div class="row" style="flex-wrap:wrap"><span class="grow small">${draft.step === 'progress' ? A(`إنشاء المشروع «${esc(draft.form.name)}» لم يُستكمل في هذه الصفحة.`, `Creating the project “${esc(draft.form.name)}” was not finished in this page.`) : A(`لديك مشروع جديد لم يكتمل إعداده: «${esc(draft.form.name)}».`, `You have a new project you did not finish setting up: “${esc(draft.form.name)}”.`)}</span><a class="btn sm" href="#/new">${A('أكمل من حيث توقفت', 'Continue where you left off')}</a></div></section>`;
      }
      function welcomePanel() {
        if (readOnly) return `<section class="panel"><h2 style="font-size:20px">${A('أهلاً في YallaFlow', 'Welcome to YallaFlow')}</h2><p class="small">${A('لسه مفيش مشاريع في الكونسول. ابدأ مشروع جديد، أو ضيف مشروع YallaFlow موجود.', 'There are no projects in the console yet. Start a new project, or add an existing YallaFlow project.')}</p></section>`;
        const card = (intent, icon, title, text, button, needs) => `<article class="intentcard" data-intent="${intent}"><span class="intent-ico" aria-hidden="true">${icon}</span><h3>${title}</h3><p class="small grow">${text}</p><p class="tiny muted">${needs}</p><button type="button" class="btn ${intent === 'create' ? 'go' : ''}" data-intent-go="${intent}">${button}</button></article>`;
        const withAgent = A('يعمل مع وكيل ذكاء اصطناعي', 'Works with an AI agent');
        return `<section class="panel welcome" data-welcome><h2 style="font-size:20px">${A('أهلاً في YallaFlow', 'Welcome to YallaFlow')}</h2><p class="small">${A('ماذا تريد أن تفعل؟ يمكنك تغيير ذلك لاحقاً لأي مشروع.', 'What do you want to do? You can change this later for any project.')}</p>
          <div class="intentgrid">
            ${card('create', '✦', A('أنشئ مشروعاً جديداً', 'Create a new project'), A('صف فكرتك والنتيجة التي تريدها. وكيلك يساعدك في اختيار التقنية ووضع الخطة، وYallaFlow يتابع التنفيذ والأدلة.', 'Describe your idea and the outcome you want. Your agent helps choose the stack and plan the work; YallaFlow keeps track of the work and its evidence.'), A('ابدأ مشروعاً جديداً', 'Start a new project'), withAgent)}
            ${card('manage', '⚙', A('أدِر مشروعاً موجوداً', 'Manage an existing project'), A('YallaFlow يفهم المشروع أولاً مع وكيلك، ويعرض عليك ما سيضيفه قبل أي تغيير. ملفاتك وتاريخ Git يبقيان كما هما.', 'YallaFlow first understands the project with your agent, and shows you what it would add before changing anything. Your files and Git history stay as they are.'), A('اختر فولدر المشروع', 'Choose the project folder'), withAgent)}
            ${card('monitor', '👁', A('تابِع مشروعاً فقط', 'Monitor a project'), A('شاهد مهام مشروع YallaFlow موجود وتقدّمه مباشرة. لا شيء يتغيّر في المشروع من هنا.', 'Watch the work and progress of an existing YallaFlow project, live. Nothing in the project changes from here.'), A('اختر مشروعاً للمتابعة', 'Choose a project to monitor'), A('بدون وكيل · للمشاريع التي فيها سجلات YallaFlow', 'No agent needed · for projects that already have YallaFlow records'))}
          </div>${welcomeAgentLine()}</section>`;
      }
      function chooseIntent(intent) {
        savePrefs({ onboarding: { intent, completed: true } });
        if (intent === 'create') { location.hash = '#/new'; return; }
        folderIntent = intent;
        openFolder('existing');
      }
      function viewProjects() {
        if (!overview) return `<p class="muted" style="margin-top:30px">${A('بيحمّل المشاريع…', 'Loading projects…')}</p>`;
        const entries = overview.map((entry) => ({ ...entry, f: projectFacts(entry, lanesOf(entry.project.id)) }));
        const shown = orderProjects(entries).filter((entry) => projectMatches(entry, pflt));
        const none = entries.length && !shown.length ? `<p class="small muted pempty">${A('مفيش مشروع مطابق.', 'No project matches.')} <button type="button" class="linkbtn" data-pf-reset>${A('امسح البحث والفلتر', 'Clear search and filter')}</button></p>` : '';
        return `<section class="pagehead"><div class="row"><h1 style="font-size:26px">${A('المشاريع', 'Projects')}</h1>${readOnly ? '' : `<button class="btn sm" data-folder-open="existing" style="margin-inline-start:auto">${A('ضيف مشروع موجود', 'Add an existing project')}</button><a class="btn sm go" href="#/new">＋ ${A('مشروع جديد', 'New project')}</a>`}</div><p class="muted pagehead-sub">${agentsOn ? A('حالة كل مشروع، شغله المفتوح، ووكلاؤه — والخطوة الجاية.', 'Each project’s state, open work and agents — and what to do next.') : A('حالة كل مشروع وشغله المفتوح — والخطوة الجاية.', 'Each project’s state and open work — and what to do next.')}</p></section>
          ${unfinishedCreation()}
          ${overview.length ? inboxSection() : ''}
          ${entries.length > 1 ? projectsToolbar(entries) : ''}
          ${overview.length ? `<section class="projects">${shown.map(projectCard).join('')}</section>${none}` : welcomePanel()}
          ${unavailable.length ? `<p class="small" style="margin-top:14px">${A('مش متاحة (الفولدر اتنقل أو اتمسح):', 'Unavailable (folder moved or deleted):')} ${unavailable.map((u) => `<span class="ltr tag">${esc(u)}${readOnly ? '' : ` <button type="button" class="tagx" data-remove-project-root="${esc(u)}" aria-label="${esc(A(`شيل ${u} من الكونسول`, `Remove ${u} from the console`))}">✕</button>`}</span>`).join(' ')}</p>` : ''}
          ${devPanel(A('إدارة قائمة المشاريع', 'Manage the project list'), ['yallaflow console add <folder>', 'yallaflow console remove <folder>', 'yallaflow console list'])}`;
      }
    
      // ---------- team: Git worktrees (checkouts), never presented as agent sessions ----------
      let team = null;
      async function loadTeam() {
        try { team = await api(`/api/p/${pid}/worktrees`); } catch (e) { team = { error: e.message }; }
      }
      const baseName = (p) => String(p).split(/[\\/]/).filter(Boolean).at(-1) ?? p;
      // PF-0112: the Agents view — every lane across this console's projects, one inbox of open
      // requests, and the session controls. Every button calls the same endpoint as the chat.
      const TASK_LABEL = {
        queued: { ar: 'في الطابور', en: 'Queued' }, starting: { ar: 'بيبدأ', en: 'Starting' }, working: { ar: 'شغّال', en: 'Working' },
        'needs-you': { ar: 'محتاجك', en: 'Needs you' }, paused: { ar: 'واقف', en: 'Paused' }, interrupted: { ar: 'اتقطع', en: 'Interrupted' },
        done: { ar: 'خلص', en: 'Done' }, failed: { ar: 'فشل', en: 'Failed' }, skipped: { ar: 'اتخطّى', en: 'Skipped' }, cancelled: { ar: 'اتلغى', en: 'Cancelled' }
      };
      const REASON_LABEL = {
        approval: { ar: 'مستني موافقتك على أداة', en: 'waiting for your approval' }, review: { ar: 'مستني مراجعتك', en: 'waiting for your review' },
        question: { ar: 'مستني إجابتك', en: 'waiting for your answer' }, reply: { ar: 'مستني ردك', en: 'waiting for your reply' },
        'usage-limit': { ar: 'وصل لحد الاستخدام', en: 'usage limit reached' }, 'agent-config': { ar: 'إعدادات الوكيل في المشروع (.codex/) اتغيرت؛ بص عليها وابدأها بنفسك', en: 'the project’s agent settings (.codex/) changed; look at them and start it yourself' }, 'session-ended': { ar: 'الجلسة خلصت قبل ما الشغل يخلص', en: 'the session ended before the work was done' },
        'console-restart': { ar: 'الكونسول اتقفل وهو شغّال', en: 'the console stopped while it worked' }, cleanup: { ar: 'فيه عمليات للوكيل لسه شغّالة', en: 'agent processes are still running' },
        crashed: { ar: 'الوكيل وقع', en: 'the agent crashed' }, developer: { ar: 'إنت وقفته', en: 'you stopped it' }
      };
      const taskTone = (s) => ({ working: 'active', starting: 'active', 'needs-you': 'you', done: 'done', failed: 'fail', interrupted: 'paused', paused: 'paused', queued: 'todo', skipped: 'closed', cancelled: 'closed' }[s] ?? '');
      function xPermCard(p) {
        const left = p.expiresAt ? Math.max(0, Math.round((Date.parse(p.expiresAt) - Date.now()) / 60000)) : null;
        return `<div class="aperm open xperm"><div class="row"><span class="ptag">${esc(p.name ?? '')}${p.workId ? ` · <span class="ltr">${esc(p.workId)}</span>` : ''}</span><b class="grow">${esc(p.title)}</b>${left !== null ? `<span class="tiny muted">${A(`فاضل ${left} د`, `${left} min left`)}</span>` : ''}</div>${permScope(p)}${p.detail ? `<pre class="pdetail" dir="ltr">${esc(p.detail)}</pre>` : ''}
          <div class="row">${(p.decisions ?? []).map((d) => `<button class="btn sm ${d === 'deny' ? 'ghost' : 'go'}" data-x-perm="${esc(p.requestId)}" data-x-pid="${esc(p.project)}" data-decision="${d}">${{ allow: A('اسمح مرة', 'Allow once'), allow_session: A('اسمح للجلسة', 'Allow for session'), deny: A('ارفض', 'Deny') }[d]}</button>`).join('')}${p.workId ? `<button class="btn sm ghost" data-x-open="${esc(p.project)}" data-x-work="${esc(p.workId)}">${A('افتح الشات', 'Open chat')}</button>` : ''}<span class="tiny muted">${A('لو محدش ردّ هيترفض تلقائي.', 'Unanswered requests are denied automatically.')}</span></div></div>`;
      }
      function xLane(lane) {
        const s = lane.session;
        const prov = s ? (s.provider === 'claude' ? 'Claude Code' : 'Codex') : '';
        const status = !s ? A('مفيش وكيل شغّال', 'No agent running') : lane.pending.length ? A('محتاج موافقتك', 'needs your approval') : s.status === 'working' ? A('شغّال', 'working') : s.status === 'starting' ? A('بيبدأ', 'starting') : s.status === 'connected' ? A('متوصّل', 'connected') : A('مستنيك', 'idle, waiting for you');
        const workedMin = lane.workingSince ? Math.floor((Date.now() - Date.parse(lane.workingSince)) / 60000) : null;
        const since = workedMin !== null ? ` · ${A(`بقاله ${mins(workedMin)}`, `for ${mins(workedMin)}`)}` : '';
        const step = lane.lastStep ? `<div class="tiny muted">${A('آخر خطوة', 'Last step')}: ${esc(lane.lastStep.title)}</div>` : '';
        const nowTasks = lane.runs.filter((run) => run.mode === 'now').flatMap((run) => run.lanes[0].tasks).slice(0, 3);
        const queues = lane.runs.filter((run) => run.mode !== 'now').slice(0, 3);
        const tasks = nowTasks;
        const controls = s && s.provider === 'codex' ? `${s.status === 'working' ? `<button class="btn sm ghost" data-x-act="cancel" data-x-pid="${esc(lane.project)}">${A('وقّف الدور', 'Stop turn')}</button>` : ''}<button class="btn sm ghost" data-x-act="end" data-x-pid="${esc(lane.project)}">${A('أنهِ الجلسة', 'End session')}</button>` : '';
        const laneBits = lane.kind === 'lane' ? `<span class="chip"><i></i>${A('مسار', 'Lane')}</span>` : '';
        const cleanupBtn = lane.kind === 'lane' && !s && latestMerge(lane)?.state === 'verified' ? `<button class="btn sm ghost" data-cleanup-open="${esc(lane.laneId ?? '')}" data-home="${esc(lane.parent ?? '')}">${A('تنظيف', 'Clean up')}</button>` : '';
        return `<section class="panel xlane ${lane.kind === 'lane' ? 'islane' : ''}"><div class="row"><b class="grow">${esc(lane.name)}</b>${laneBits}${s ? `<span class="chip ${lane.pending.length ? 'you' : s.status === 'working' ? 'active' : 'wait'}"><i></i>${esc(prov)} · ${status}</span>` : `<span class="chip"><i></i>${status}</span>`}</div>
          ${lane.lockedBy ? `<p class="tiny muted">${esc(lane.lockedBy)}</p>` : ''}${lane.store === 'unreadable' ? `<p class="tiny fail">${A('ملف التشغيل مش مقروء ومش هيتكتب فوقه', 'The runs file is unreadable and will not be overwritten')}: <span${trDir(lane, 'storeError')}>${trHtml(lane, 'storeError')}</span></p>` : lane.storeError ? `<p class="tiny fail"${trDir(lane, 'storeError')}>${trHtml(lane, 'storeError')}</p>` : ''}
          ${s?.workId ? `<div class="small">${A('على', 'On')} <a href="#" data-x-open="${esc(lane.project)}" data-x-work="${esc(s.workId)}" class="ltr">${esc(s.workId)}</a>${since}</div>` : ''}${step}
          ${tasks.length ? `<ul class="xtasks">${tasks.map((task) => `<li><span class="chip ${taskTone(task.state)}"><i></i>${L(TASK_LABEL[task.state] ?? { ar: esc(task.state), en: esc(task.state) })}</span> <a href="#" data-x-open="${esc(lane.project)}" data-x-work="${esc(task.workId)}" class="ltr">${esc(task.workId)}</a>${task.reason && REASON_LABEL[task.reason] ? ` <span class="tiny muted">${L(REASON_LABEL[task.reason])}${task.retryAt ? ` · ${A('يرجع', 'retry')} ${esc(task.retryAt)}` : ''}</span>` : ''}${task.itemDone && task.state !== 'done' ? ` <span class="tiny muted">${A('الشغل خلص؛ الجلسة لسه مفتوحة', 'work DONE; the session is still open')}</span>` : ''}</li>`).join('')}</ul>` : ''}
          ${queues.map((run) => xRun(lane, run)).join('')}
          ${lane.kind === 'lane' ? mergeBlock(lane) : ''}
          ${controls || cleanupBtn ? `<div class="row">${controls}${cleanupBtn}</div>` : ''}</section>`;
      }
      const RUN_LABEL = { running: { ar: 'شغّال', en: 'running' }, paused: { ar: 'واقف', en: 'paused' }, finished: { ar: 'خلص', en: 'finished' }, cancelled: { ar: 'اتلغى', en: 'cancelled' } };
      function xRun(lane, run) {
        const list = run.lanes[0].tasks;
        const live = ['finished', 'cancelled'].includes(run.state) ? false : true;
        const btn = (act, label, extra = '', cls = 'ghost') => `<button class="btn sm ${cls}" data-run-act="${act}" data-x-pid="${esc(lane.project)}" data-run="${esc(run.id)}" ${extra}>${label}</button>`;
        const queuedIds = list.filter((task) => task.state === 'queued').map((task) => task.id);
        const head = list.find((task) => task.state === 'queued');
        const assisted = live && head && head.provider === 'claude' && !list.some((task) => ['starting', 'working', 'needs-you'].includes(task.state));
        return `<div class="xrun"><div class="row"><b>${A('طابور', 'Queue')}</b><span class="chip ${run.state === 'running' ? 'active' : run.state === 'finished' ? 'done' : run.state === 'cancelled' ? 'closed' : 'paused'}"><i></i>${L(RUN_LABEL[run.state] ?? { ar: esc(run.state), en: esc(run.state) })}</span>${run.awaitNext ? `<span class="tiny muted">${A('مستني «كمّل»', 'waiting for Continue')}</span>` : ''}${run.held ? `<span class="tiny muted">${A('موقوف مؤقتاً', 'paused by you')}</span>` : ''}${run.cancelAfter ? `<span class="tiny muted">${A('هيتلغى بعد المهمة الحالية', 'cancels after the current task')}</span>` : ''}</div>
          <ol class="xtasks">${list.map((task) => {
            const qi = queuedIds.indexOf(task.id);
            const acts = [
              ['interrupted', 'paused'].includes(task.state) && task.provider === 'codex' ? btn('resume', A('كمّل', 'Resume'), `data-task="${esc(task.id)}"`, 'go') : '',
              ['failed', 'paused', 'interrupted'].includes(task.state) ? btn('retry', A('من الأول', 'Retry'), `data-task="${esc(task.id)}"`) : '',
              ['queued', 'paused', 'failed', 'interrupted'].includes(task.state) ? btn('skip', A('تخطّى', 'Skip'), `data-task="${esc(task.id)}"`) : '',
              qi > 0 ? btn('up', '↑', `data-task="${esc(task.id)}" aria-label="${A('لفوق', 'Up')}"`) : '',
              qi !== -1 && qi < queuedIds.length - 1 ? btn('down', '↓', `data-task="${esc(task.id)}" aria-label="${A('لتحت', 'Down')}"`) : ''
            ].join('');
            return `<li><span class="chip ${taskTone(task.state)}"><i></i>${L(TASK_LABEL[task.state] ?? { ar: esc(task.state), en: esc(task.state) })}</span> <a href="#" data-x-open="${esc(lane.project)}" data-x-work="${esc(task.workId)}" class="ltr">${esc(task.workId)}</a>${task.provider === 'claude' ? ' <span class="tiny muted">Claude Code</span>' : ''}${task.reason && REASON_LABEL[task.reason] ? ` <span class="tiny muted">${L(REASON_LABEL[task.reason])}${task.retryAt ? ` · ${A('يرجع', 'retry')} ${esc(task.retryAt)}` : ''}</span>` : ''}${acts ? `<span class="xacts">${acts}</span>` : ''}</li>`;
          }).join('')}</ol>
          ${assisted ? `<p class="tiny">${A(`ابدأ ${esc(head.workId)} في Claude Code واربطه من الشات. الكونسول مبيقدرش يشغّل Claude Code بنفسه.`, `Start ${esc(head.workId)} in Claude Code and link it from the chat. The console cannot start Claude Code itself.`)}</p>` : ''}${queueWaitNote(lane, run)}
          ${live ? `<div class="row">${run.held || run.awaitNext ? btn('next', A('كمّل الطابور', 'Continue queue'), '', 'go') : btn('pause', A('وقّف بعد الحالية', 'Pause after current'))}${run.cancelAfter ? '' : btn('cancel-after', A('ألغي بعد الحالية', 'Cancel after current'))}${btn('cancel-now', A('ألغي دلوقتي', 'Cancel now'))}${run.options?.provider !== 'claude' && lane.userSessions ? btn('switch', A('كمّل الباقي بـ Claude Code', 'Continue the rest with Claude Code'), 'data-provider="claude"') : ''}${run.options?.provider === 'claude' ? btn('switch', A('كمّل الباقي بـ Codex', 'Continue the rest with Codex'), 'data-provider="codex"') : ''}</div>` : ''}</div>`;
      }
      // PF-0143 (B5): a queue whose next task cannot start because another session holds the
      // checkout says so, with what the developer can do (Claude Code has no Stop in the console).
      function queueBlock(lane, run) {
        if (['finished', 'cancelled'].includes(run.state) || run.held || run.awaitNext) return null;
        const list = run.lanes[0].tasks;
        if (list.some((task) => ['starting', 'working', 'needs-you'].includes(task.state))) return null;
        const head = list.find((task) => task.state === 'queued');
        const s = lane.session;
        if (!head || head.provider === 'claude' || !s || s.workId === head.workId) return null;
        return { head, session: s };
      }
      function queueWaitNote(lane, run) {
        const b = queueBlock(lane, run);
        if (!b) return '';
        const who = PROVIDER[b.session.provider] ?? esc(b.session.provider);
        const on = b.session.workId ? A(` على ${esc(b.session.workId)}`, ` on ${esc(b.session.workId)}`) : '';
        const how = b.session.provider === 'claude' ? A('اكتب /exit في ترمينال Claude Code عشان يقفل؛ الطابور هيكمّل لوحده.', 'Type /exit in the Claude Code terminal to close it; the queue continues by itself.') : A('اقفل الجلسة دي من الشات بتاعها؛ الطابور هيكمّل لوحده.', 'End that session from its chat; the queue continues by itself.');
        return `<p class="tiny warn" role="status" data-queue-wait>⏸ ${A(`الطابور مستني جلسة ${who}${on} تقفل قبل ما يبدأ ${esc(b.head.workId)}.`, `The queue waits for the ${who} session${on} to close before it starts ${esc(b.head.workId)}.`)} ${how}</p>`;
      }
      // The same signal on the Workspace, for this project's queues.
      function queueStrip() {
        const notes = (execView?.lanes ?? []).filter((lane) => lane.project === pid).flatMap((lane) => lane.runs.map((run) => queueWaitNote(lane, run))).filter(Boolean);
        return notes.length ? `<section class="panel" style="margin-bottom:12px">${notes.join('')}</section>` : '';
      }
      // PF-0132: the Agents page lives in Projects (the Needs-you inbox and each card's agents) and
      // in Worktrees (this project's queues, merges and session controls). #/agents lands on the inbox.
      function limitNotices() {
        return (execView?.limits ?? []).map((limit) => `<section class="errbar" role="status"><b>${A(`${limit.provider === 'codex' ? 'Codex' : 'Claude Code'} وصل لحد الاستخدام${limit.retryAt ? ` (يرجع ${esc(limit.retryAt)})` : ''}. الطوابير اللي عليه واقفة.`, `${limit.provider === 'codex' ? 'Codex' : 'Claude Code'} reached its usage limit${limit.retryAt ? ` (try again at ${esc(limit.retryAt)})` : ''}. Queues on it are paused.`)}</b><p class="small">${A('كمّل المهمة الواقفة لما الحد يرجع، أو كمّل الباقي بالوكيل التاني من كارت الطابور.', 'Resume the paused task when the limit resets, or continue the rest with the other agent from the queue card.')}</p></section>`).join('');
      }
      function inboxSection() {
        if (!agentsOn) return '';
        const inbox = execView?.inbox ?? [];
        // PF-0169: nothing waiting is one slim line; requests are the full, prominent list.
        if (!inbox.length) return `<p class="inbox-ok tiny" id="inbox" role="status">${!execView ? `<span class="muted">${execError ? esc(execError) : A('بيحمّل طلبات الوكلاء…', 'Loading agent requests…')}</span>` : `<span class="chip done"><i></i>${A('مفيش حاجة مستنياك', 'Nothing needs you')}</span><span class="muted">${A('طلبات الوكلاء من كل المشاريع بتظهر هنا.', 'Agent requests from every project appear here.')}</span>`}</p>${limitNotices()}`;
        return `<section class="inbox has" id="inbox" aria-labelledby="inbox-h"><div class="row inbox-h"><h2 id="inbox-h">${A('محتاجك', 'Needs you')}</h2><span class="pbadge you">${inbox.length}</span><span class="tiny muted grow">${A('طلبات الوكلاء من كل المشاريع. لو محدش ردّ، الطلب بيترفض تلقائي — عمره ما بيتوافق عليه لوحده.', 'Agent requests from every project. Unanswered requests are denied automatically — never approved on their own.')}</span></div><div class="inbox-list">${inbox.map(xPermCard).join('')}</div></section>${limitNotices()}`;
      }
      const lanesOf = (projectId) => (execView?.lanes ?? []).filter((lane) => lane.project === projectId || (lane.kind === 'lane' && lane.parent === projectId));
      // PF-0169: what one agent lane is doing now, for a project card — or null when all it holds is
      // history. A run task whose work item is DONE or closed, or that has finished, is history; a
      // paused or interrupted task (a console restart interrupts live ones) can be resumed.
      const FINAL_TASK = ['done', 'failed', 'skipped', 'cancelled'];
      function laneStatus(lane, closed = new Set()) {
        const s = lane.session;
        const tasks = lane.runs.filter((run) => !['finished', 'cancelled'].includes(run.state)).flatMap((run) => (run.lanes ?? []).flatMap((entry) => entry.tasks ?? [])).filter((task) => !FINAL_TASK.includes(task.state) && !closed.has(task.workId));
        const resumable = tasks.find((task) => ['paused', 'interrupted', 'starting', 'working', 'needs-you'].includes(task.state));
        const queued = tasks.find((task) => task.state === 'queued');
        const work = s?.workId ?? resumable?.workId ?? queued?.workId ?? null;
        if (lane.pending?.length) return { key: 'approval', tone: 'you', label: A('محتاج موافقتك', 'needs your approval'), work };
        if (s?.status === 'working') return { key: 'working', tone: 'active', label: A('شغّال', 'working'), work };
        if (s?.status === 'starting') return { key: 'starting', tone: 'active', label: A('بيبدأ', 'starting'), work };
        if (s) return { key: 'session', tone: 'wait', label: s.status === 'connected' ? A('الجلسة مفتوحة', 'session open') : A('الجلسة مستنياك', 'session waiting for you'), work };
        if (resumable) return { key: 'paused', tone: 'idle', label: A('متوقف — ينفع يكمّل', 'paused — can resume'), work };
        if (queued) return { key: 'queued', tone: 'todo', label: A('في الطابور', 'queued'), work };
        if (lane.kind === 'lane') return { key: 'lane', tone: 'todo', label: A('مفيش وكيل شغّال', 'no agent running'), work: null };
        return null;
      }
      function laneRow(lane, st) {
        const s = lane.session;
        const prov = s ? (s.provider === 'claude' ? ['c', 'Claude Code'] : ['x', 'Codex']) : null;
        const workedMin = st.key === 'working' && lane.workingSince ? Math.floor((Date.now() - Date.parse(lane.workingSince)) / 60000) : null;
        const detail = [s && lane.lastStep?.title ? esc(lane.lastStep.title) : '', workedMin !== null ? A(`بقاله ${mins(workedMin)}`, `for ${mins(workedMin)}`) : ''].filter(Boolean).join(' · ');
        return `<li class="plane" data-lane-state="${st.key}"><span class="plane-prov ${prov ? prov[0] : ''}" ${prov ? `title="${prov[1]}"` : ''} aria-hidden="true">${prov ? prov[0].toUpperCase() : '–'}</span><div class="grow plane-body"><div class="plane-top">${st.work ? `<a href="#" class="ltr" data-x-open="${esc(lane.project)}" data-x-work="${esc(st.work)}">${esc(st.work)}</a>` : ''}${lane.kind === 'lane' ? `<span class="tag ltr" title="${esc(A('مسار (worktree)', 'Lane (worktree)'))}">${esc(lane.name)}</span>` : ''}</div>${detail ? `<div class="tiny muted plane-step">${detail}</div>` : ''}</div><span class="chip ${st.tone}"><i></i>${prov ? `<span class="sr-only">${prov[1]}: </span>` : ''}${st.label}</span></li>`;
      }
      // The work items a card treats as history for its agent rows: DONE or closed in its snapshot.
      const closedWork = (snap) => new Set((snap?.items ?? []).filter((it) => ['done', 'closed'].includes(it.state)).map((it) => it.id));
      function cardAgents(project, closed = new Set()) {
        if (!agentsOn || !execView) return '';
        const rows = lanesOf(project.id).map((lane) => [lane, laneStatus(lane, closed)]).filter(([, st]) => st);
        // PF-0169: no panel when nothing is live — history stays on Worktrees.
        if (!rows.length) return '';
        return `<div class="pagents"><ul class="planes" aria-label="${esc(A('الوكلاء', 'Agents'))}">${rows.map(([lane, st]) => laneRow(lane, st)).join('')}</ul><button type="button" class="linkbtn tiny" data-open-project="${esc(project.id)}" data-open-view="team">${A('الطوابير والدمج والتحكم في الجلسة', 'Queues, merges and session controls')} ${fwd()}</button></div>`;
      }
    
      // ---------- PF-0169: the Projects page — what each card says, from recorded data only ----------
      let pflt = { q: '', st: 'all', sort: 'recent' };
      let projOrder = null; // { sort, ids }: the card order, frozen for this visit so live updates never reshuffle it
      const OPEN_STATES = ['new', 'active', 'paused', 'you', 'fail'];
      const SETUP_UNDERSTANDING = ['PROJECT_UNDERSTANDING_REQUIRED', 'PROJECT_UNDERSTANDING_IN_PROGRESS', 'PROJECT_UNDERSTANDING_AWAITING_REVIEW'];
      // An item's latest recorded moment: its last activity, else its last update, else its creation.
      const lastMoment = (it) => it.lastActivityAt ?? it.updatedAt ?? it.createdAt ?? '';
      const byRecent = (a, b) => String(lastMoment(b)).localeCompare(String(lastMoment(a)));
      function projectFacts(entry, lanes = []) {
        const closed = closedWork(entry.snap);
        const live = lanes.map((lane) => laneStatus(lane, closed)).filter(Boolean);
        const agents = {
          live: live.length,
          pending: lanes.reduce((n, lane) => n + (lane.pending?.length ?? 0), 0),
          working: live.filter((st) => ['working', 'starting'].includes(st.key)).length
        };
        const understanding = entry.health?.understanding ?? null;
        const baselineId = entry.health?.baselineId ?? null;
        const s = entry.snap;
        if (entry.error || !s) return { error: entry.error ?? 'unavailable', items: 0, open: 0, done: 0, held: 0, you: 0, fail: 0, invalid: 0, lastAt: null, current: null, closed, understanding, baselineId, ...agents };
        const items = s.items ?? [];
        const open = items.filter((it) => OPEN_STATES.includes(it.state));
        const active = s.project?.activeWork ?? null;
        // The item the card leads with: one waiting for you, then a failing one, then the
        // project's active work, then the most recent open item.
        const current = open.find((it) => it.state === 'you') ?? open.find((it) => it.state === 'fail') ?? open.find((it) => it.id === active) ?? [...open].sort(byRecent)[0] ?? null;
        return {
          error: null,
          items: items.length,
          open: open.length,
          done: items.filter((it) => it.state === 'done').length,
          held: items.filter((it) => it.state === 'held').length,
          you: open.filter((it) => it.state === 'you').length,
          fail: open.filter((it) => it.state === 'fail').length,
          invalid: s.invalid?.length ?? 0,
          lastAt: items.map(lastMoment).filter(Boolean).sort().at(-1) ?? null,
          current,
          closed,
          understanding,
          baselineId,
          ...agents
        };
      }
      // One execution state per card; "working" only with a working agent session.
      function projectState(f) {
        if (f.error) return { key: 'error', tone: 'fail', label: A('السجلات مش مقروءة', 'Records unreadable') };
        if (f.pending || f.you) return { key: 'you', tone: 'you', label: A('محتاجك', 'Needs you') };
        if (f.fail) return { key: 'fail', tone: 'fail', label: A('فيه فحص فشل', 'A check failed') };
        if (f.working) return { key: 'running', tone: 'active', label: A('وكيل شغّال', 'Agent working') };
        if (f.open) return { key: 'open', tone: 'openw', label: A('فيه شغل مفتوح', 'Open work') };
        if (f.done) return { key: 'done', tone: 'done', label: A('كل المهام خلصت', 'All tasks completed') };
        return { key: 'empty', tone: 'todo', label: A('لسه مفيش شغل', 'No work yet') };
      }
      const needsSetup = (f, readinessData = null) => SETUP_UNDERSTANDING.includes(f.understanding) || Boolean(readinessData?.steps?.some((st) => st.id === 'agent' && st.status === 'choose'));
      // The one next action a card offers, from recorded state and an existing console destination.
      // ctx: { monitor, readOnly, readiness } — readiness is known only for the current project.
      function nextAction(projectId, f, { monitor = false, readOnly: ro = false, readiness: rd = null } = {}) {
        if (f.error) return null;
        const write = !monitor && !ro;
        const item = (it, label, attn = false) => ({ kind: 'item', work: it.id, label, attn });
        const view = (v, label, attn = false) => ({ kind: 'view', view: v, label, attn });
        if (f.pending && write) return { kind: 'inbox', label: A('راجع طلب الوكيل', 'Review the agent request'), attn: true };
        const you = f.current?.state === 'you' ? f.current : null;
        if (you) return write ? item(you, you.waitingFor?.kind === 'question' ? A('جاوب السؤال', 'Answer the question') : A('راجع القرار', 'Review the decision'), true) : item(you, A(`افتح ${you.id}`, `Open ${you.id}`));
        if (write && f.understanding === 'PROJECT_UNDERSTANDING_AWAITING_REVIEW') return f.baselineId ? { kind: 'item', work: f.baselineId, label: A('راجع فهم المشروع', 'Review project understanding'), attn: true } : view('map', A('راجع فهم المشروع', 'Review project understanding'), true);
        if (write && f.understanding === 'PROJECT_UNDERSTANDING_REQUIRED') return view('map', A('ابدأ فهم المشروع', 'Start project understanding'));
        if (write && f.understanding === 'PROJECT_UNDERSTANDING_IN_PROGRESS') return f.baselineId ? { kind: 'item', work: f.baselineId, label: A('كمّل فهم المشروع', 'Continue project understanding') } : view('map', A('كمّل فهم المشروع', 'Continue project understanding'));
        if (write && rd?.steps?.some((st) => st.id === 'agent' && st.status === 'choose')) return view('settings/agents', A('كمّل الإعداد', 'Continue setup'));
        if (f.current?.state === 'fail') return item(f.current, A('افتح الشغل اللي فشل', 'Open the failing work'), true);
        if (f.working) return view('team', A('شوف الشغل الشغّال', 'View running work'));
        if (f.current) return item(f.current, A(`كمّل ${f.current.id}`, `Continue ${f.current.id}`));
        return null;
      }
      // The filters never overlap: each project falls in exactly one, by this precedence, so the
      // counts add up to All. "Open work" says nothing about agents running.
      const FILTERS = [
        ['all', { ar: 'الكل', en: 'All' }],
        ['attention', { ar: 'محتاجك', en: 'Needs you' }],
        ['setup', { ar: 'محتاج إعداد', en: 'Needs setup' }],
        ['open', { ar: 'فيه شغل مفتوح', en: 'Open work' }],
        ['idle', { ar: 'مفيش شغل مفتوح', en: 'No open work' }]
      ];
      function projectGroup(entry) {
        const st = projectState(entry.f).key;
        if (['you', 'fail', 'error'].includes(st)) return 'attention';
        if (needsSetup(entry.f, entry.project.id === pid && readiness?.pid === pid ? readiness.data : null)) return 'setup';
        if (['running', 'open'].includes(st)) return 'open';
        return 'idle';
      }
      const projectFilterKey = (entry, key) => key === 'all' || projectGroup(entry) === key;
      function projectMatches(entry, by) {
        const q = String(by.q ?? '').trim().toLowerCase();
        if (q && !`${entry.project.name ?? ''}\n${entry.project.root ?? ''}`.toLowerCase().includes(q)) return false;
        return projectFilterKey(entry, by.st ?? 'all');
      }
      const GROUP_RANK = { attention: 0, setup: 1, open: 2, idle: 3 };
      function sortProjects(entries, sort) {
        const recent = (a, b) => String(b.f.lastAt ?? '').localeCompare(String(a.f.lastAt ?? '')) || String(a.project.name).localeCompare(String(b.project.name));
        return [...entries].sort(sort === 'attention' ? (a, b) => GROUP_RANK[projectGroup(a)] - GROUP_RANK[projectGroup(b)] || recent(a, b) : recent);
      }
      // Frozen per visit: a project that becomes active later keeps its place until the page is
      // opened again or the order is changed; a newly added project goes last.
      function orderProjects(entries) {
        if (!projOrder || projOrder.sort !== pflt.sort) projOrder = { sort: pflt.sort, ids: [] };
        // Projects not placed yet (the first draw, or one added since) go after the placed ones, in sort order.
        const fresh = sortProjects(entries.filter((e) => !projOrder.ids.includes(e.project.id)), pflt.sort);
        projOrder.ids.push(...fresh.map((e) => e.project.id));
        const at = (e) => projOrder.ids.indexOf(e.project.id);
        return [...entries].sort((a, b) => at(a) - at(b));
      }
      function projectsToolbar(entries) {
        const count = (key) => entries.filter((e) => projectFilterKey(e, key)).length;
        const chips = FILTERS.map(([key, label]) => [key, label, count(key)]).filter(([key, , n]) => key === 'all' || n || pflt.st === key)
          .map(([key, label, n]) => `<button type="button" class="fchip ${pflt.st === key ? 'on' : ''}" data-pf="${key}" aria-pressed="${pflt.st === key}">${L(label)} <span class="pfn">${n}</span></button>`).join('');
        return `<section class="ptools" aria-label="${esc(A('دوّر في المشاريع', 'Find a project'))}">
          <input type="search" data-pq value="${esc(pflt.q)}" placeholder="${esc(A('دوّر بالاسم أو المسار…', 'Search by name or path…'))}" aria-label="${esc(A('دوّر في المشاريع', 'Search projects'))}">
          <div class="pfchips" role="group" aria-label="${esc(A('فلتر بالحالة', 'Filter by status'))}">${chips}</div>
          <label class="psort tiny muted">${A('الترتيب', 'Order')} <select data-psort><option value="recent" ${pflt.sort === 'recent' ? 'selected' : ''}>${A('آخر نشاط', 'Latest activity')}</option><option value="attention" ${pflt.sort === 'attention' ? 'selected' : ''}>${A('اللي محتاجك الأول', 'Needs attention first')}</option></select></label>
        </section>`;
      }
      function projectMenu(project) {
        const items = [
          readOnly ? '' : `<button type="button" role="menuitem" class="projmenu-item" data-open-folder="${esc(project.id)}"><span class="projmenu-check" aria-hidden="true">▢</span>${A('افتح الفولدر', 'Open folder')}</button>`,
          `<button type="button" role="menuitem" class="projmenu-item" data-copy="${esc(project.root ?? '')}" data-copy-what="path"><span class="projmenu-check" aria-hidden="true">⧉</span>${A('انسخ المسار', 'Copy path')}</button>`,
          readOnly ? '' : `<div class="projmenu-sep" role="separator"></div><button type="button" role="menuitem" class="projmenu-item danger" data-remove-project="${esc(project.id)}"><span class="projmenu-check" aria-hidden="true">✕</span>${A('شيل من الكونسول…', 'Remove from the console…')}</button>`
        ].join('');
        return `<details class="pcard-menu" data-popmenu><summary class="pcard-more" aria-haspopup="menu" aria-label="${esc(A(`إجراءات تانية لـ ${project.name}`, `More actions for ${project.name}`))}" title="${esc(A('إجراءات تانية', 'More actions'))}"><span aria-hidden="true">⋯</span></summary><div class="projmenu-panel pcard-menu-panel" role="menu">${items}</div></details>`;
      }
      function nextButton(projectId, act) {
        if (!act) return '';
        const cls = `btn sm pcard-next ${act.attn ? 'attn' : ''}`;
        if (act.kind === 'inbox') return `<button type="button" class="${cls}" data-pinbox>${act.label}</button>`;
        if (act.kind === 'item') return `<button type="button" class="${cls}" data-x-open="${esc(projectId)}" data-x-work="${esc(act.work)}">${act.label}</button>`;
        return `<button type="button" class="${cls}" data-open-project="${esc(projectId)}" data-open-view="${esc(act.view)}">${act.label}</button>`;
      }
      function projectCard({ project, health, f }) {
        const here = project.id === pid;
        const monitor = projectMode(project.id) === 'monitor';
        const state = projectState(f);
        const act = nextAction(project.id, f, { monitor, readOnly, readiness: here && readiness?.pid === pid ? readiness.data : null });
        const tail = String(project.root ?? '').split(/[\\/]/).filter(Boolean).slice(-2).join('/');
        // Counts say only what is there; with nothing open, the state chip is the one empty-work message.
        const counts = f.error ? '' : [f.open ? A(`${f.open} مفتوح`, `${f.open} open`) : '', f.done ? A(`${f.done} خلص`, `${f.done} done`) : '', f.held ? A(`${f.held} متوقف`, `${f.held} on hold`) : ''].filter(Boolean).join(' · ');
        const it = f.current;
        const work = f.error
          ? `<p class="small pcard-err">${A('YallaFlow مش قادر يقرا سجلات المشروع ده:', 'YallaFlow cannot read this project\'s records:')} ${esc(f.error)}</p>`
          : it
            ? `<a href="#" class="pcard-work" data-x-open="${esc(project.id)}" data-x-work="${esc(it.id)}"><span class="pcard-wid ltr">${esc(it.id)}</span><span class="pcard-wtitle" dir="auto">${esc(it.title)}</span><span class="tiny muted pcard-wst">${['you', 'fail'].includes(it.state) ? `${L(STATE[it.state])} · ` : ''}${esc(stName(curIndex(it)))}</span></a>`
            : '';
        return `<article class="pcard panel ${here ? 'here' : ''}" data-card-open="${esc(project.id)}" data-pstate="${state.key}">
            <header class="pcard-head"><div class="grow pcard-id"><div class="pcard-tline"><a class="pcard-title" href="#/map" data-open-project="${esc(project.id)}"><h2 dir="auto">${esc(project.name)}</h2></a>${here ? `<span class="tag pcard-here">${A('المشروع الحالي', 'Current')}</span>` : ''}</div><span class="ltr tiny muted pcard-path" title="${esc(project.root ?? '')}">…/${esc(tail)}</span></div>${projectMenu(project)}</header>
            <div class="row pcard-status"><span class="chip ${state.tone}" data-state-chip><i></i>${state.label}</span>${monitor ? `<span class="chip wait" data-mode-chip="monitor">👁 ${A('متابعة فقط', 'Monitor only')}</span>` : ''}${f.invalid ? `<span class="chip wait">⚠ ${f.invalid} ${A('سجلات مش سليمة', 'invalid records')}</span>` : ''}<span class="tiny muted pcard-counts">${counts}</span></div>
            ${work}
            ${cardAgents(project, f.closed)}
            ${cardHealth(project, health)}
            <footer class="pcard-foot"><button type="button" class="btn sm go" data-open-project="${esc(project.id)}">${A('افتح المشروع', 'Open project')}</button>${nextButton(project.id, act)}<span class="grow"></span><span class="tiny muted pcard-last">${f.lastAt ? A(`آخر نشاط ${ago(f.lastAt)}`, `Active ${ago(f.lastAt)}`) : ''}</span></footer>
          </article>`;
      }
      // Worktrees: this project's agent lanes in full (queues, Review & Merge, Clean up, session controls).
      function agentLanesSection() {
        if (!agentsOn) return '';
        const mine = lanesOf(pid);
        return `<section class="xlanes-sec" id="agents"><div class="pagehead" style="margin-top:22px"><h2 style="font-size:20px">${A('الوكلاء والطوابير', 'Agents and queues')}</h2><p class="small muted">${A('جلسات الوكلاء في المشروع ده ومساراته: الطوابير، الدمج، والتحكم في الجلسة. كل زرار هنا بيعمل نفس اللي في الشات. طلبات الموافقة في «المشاريع».', 'Agent sessions in this project and its lanes: queues, merges and session controls. Each button does the same as in the chat. Approval requests are on Projects.')}</p></div>${limitNotices()}
          ${!execView ? `<p class="tiny muted">${execError ? esc(execError) : A('بيحمّل…', 'Loading…')}</p>` : `<div class="xlanes">${mine.map(xLane).join('') || `<p class="tiny muted">${A('مفيش وكيل شغّال.', 'No agent running.')}</p>`}</div>`}</section>`;
      }
    
      function viewTeam() {
        if (!team) return `<p class="muted" style="margin-top:30px">${A('بيحمّل…', 'Loading…')}</p>`;
        if (team.error) return `<section class="errbar">${esc(team.error)}</section>`;
        if (!team.git) return `<section class="pagehead"><h1 style="font-size:26px">${A('نسخ الشغل', 'Worktrees')}</h1><p class="muted">${A('المشروع ده مش جوه Git repository لسه.', 'This project is not in a Git repository yet.')}</p></section><section class="panel"><p class="small">${A('نسخ الشغل (git worktrees) بتخليك تشغّل أكتر من وكيل على شغلانات مختلفة في نفس الوقت من غير ما يتداخلوا. محتاجة Git الأول.', 'Worktrees (git worktrees) let you run several agents on different work items at the same time without collisions. They need Git first.')}</p>${readOnly ? '' : `<button class="btn sm go" data-git-init style="margin-top:8px">${A('اعمل Git repository', 'Initialize Git')}</button><p class="tiny muted">${A('git init بس: من غير remote ولا commit ولا push.', 'git init only: no remote, commit or push.')}</p>`}</section>${agentLanesSection()}`;
        const lane = (w) => {
          const a = w.activeWork;
          const at = a ? (a.state === 'done' ? 5 : a.state === 'new' ? -1 : stIndex(a.currentStation)) : null;
          const track = a ? `<div class="track" aria-hidden="true">${ST.map((s, i) => `<span class="tk ${at > i || at === 5 ? 'done' : at === i ? `now ${a.state}` : ''}" style="--hue:${s.hue}" data-tip="${esc(L(s.name))}"><i></i></span>`).join('')}<span class="tk end ${at === 5 ? 'done' : ''}" style="--hue:var(--palm)"><i>✓</i></span></div>` : '';
          const changed = w.changed ?? [];
          const hot = new Set((team.overlaps ?? []).map((o) => o.path));
          return `<article class="lane panel ${a ? a.state : ''}"><div class="lh"><div class="grow"><b class="ltr">⑂ ${esc(w.branch ?? '—')}</b>${w.main ? ` <span class="tag">${A('الأساسية', 'main checkout')}</span>` : ''}<div class="tiny muted ltr" title="${esc(w.path)}">📁 ${esc(baseName(w.path))}</div></div></div>
            <div class="lm">${w.unverified ? `<p class="muted">${A('git مسجّل النسخة دي بس الفولدر مش بيرجعلها، فاتجاهلت.', 'Git lists this worktree, but its folder does not point back to it, so it is ignored.')}</p>` : !w.exists ? `<p class="muted">${A('الفولدر ده مش موجود على الجهاز.', 'This folder is not on disk.')}</p>` : !w.yallaflow ? `<p class="muted">${A('مفيش حالة YallaFlow في النسخة دي.', 'No YallaFlow state in this checkout.')}</p>` : a ? `<a href="#/item/${encodeURIComponent(a.id)}" class="lt"><span class="ltr tiny muted">${esc(a.id)}</span> ${esc(a.title)}</a>${track}<div class="row tiny" style="margin-top:6px">${chip(a.state)}<b>${a.completion}%</b>${w.lastRecordedActivity ? `<span class="muted">${A(`آخر نشاط مسجّل ${ago(w.lastRecordedActivity)}`, `last recorded activity ${ago(w.lastRecordedActivity)}`)}</span>` : ''}</div>` : `<p class="muted">${A('مفيش شغل نشط مسجّل هنا.', 'No active work recorded here.')}</p>`}</div>
            <div class="lf">${changed.length ? `<details><summary class="small">${A(`${changed.length} ملف متغيّر`, `${changed.length} changed file(s)`)}${changed.some((f) => hot.has(f.path)) ? ` <span class="chip fail">${A('فيه تداخل', 'overlap')}</span>` : ''}</summary><div class="fl">${changed.slice(0, 60).map((f) => `<span class="fpath ltr ${hot.has(f.path) ? 'hot' : ''}">${esc(f.path)}</span>`).join('')}</div></details>` : `<span class="tiny muted">${w.changed === null ? A('مش قادر أقرا التغييرات', 'changes unavailable') : A('مفيش تغييرات', 'no changes')}</span>`}</div></article>`;
        };
        return `<section class="pagehead"><h1 style="font-size:26px">${A('نسخ الشغل', 'Worktrees')}</h1><p class="muted">${A('كل نسخة شغل (git worktree) من المشروع، وحالة YallaFlow المسجّلة فيها والملفات اللي اتغيّرت. الكونسول مايعرفش مين شغّال جوه كل نسخة، ومش بيعرضها كجلسات وكلاء.', 'Every Git worktree of this project, its recorded YallaFlow state and its changed files. The console cannot tell who is working in a checkout and does not present them as agent sessions.')}</p></section>
          ${(team.overlaps ?? []).map((o) => `<section class="conflict"><b>⚠ ${A('نفس الملف متغيّر في أكتر من نسخة', 'The same file is changed in more than one worktree')}:</b> <span class="ltr">${esc(o.path)}</span><div class="tiny muted ltr">${o.worktrees.map((w) => `📁 ${esc(baseName(w))}`).join(' · ')}</div></section>`).join('')}
          <section class="lanes">${team.worktrees.map(lane).join('')}</section>
          ${agentLanesSection()}
          ${team.worktrees.length === 1 ? devPanel(A('شغّل أكتر من وكيل بأمان', 'Run more agents safely'), ['git worktree add ../<folder> -b <branch>', 'cd ../<folder>   # open your agent here, on a different work item']) : ''}`;
      }
    
      // ---------- insights: only what YallaFlow records ----------
      function viewInsights() {
        const all = items();
        const doneItems = all.filter((it) => it.state === 'done' && it.completedAt);
        const day = 86400000;
        const now = Date.now();
        const last30 = doneItems.filter((it) => now - Date.parse(it.completedAt) <= 30 * day).length;
        const cycles = doneItems.filter((it) => it.createdAt).map((it) => (Date.parse(it.completedAt) - Date.parse(it.createdAt)) / day).filter((x) => x >= 0).sort((a, b) => a - b);
        const median = cycles.length ? cycles[Math.floor((cycles.length - 1) / 2)] : null;
        const runs = all.reduce((acc, it) => ({ total: acc.total + (it.verificationRuns?.total ?? 0), passed: acc.passed + (it.verificationRuns?.passed ?? 0) }), { total: 0, passed: 0 });
        const weeks = Array.from({ length: 8 }, (_, k) => { const end = now - (7 - k) * 7 * day; const start = end - 7 * day; return { start, end, n: doneItems.filter((it) => { const t = Date.parse(it.completedAt); return t > start && t <= end; }).length }; });
        const wmax = Math.max(1, ...weeks.map((w) => w.n));
        const live = all.filter((it) => it.state !== 'done' && it.state !== 'closed');
        const fresh = live.filter((it) => it.state === 'new').length;
        const open = ST.map((_, i) => live.filter((it) => it.state !== 'new' && curIndex(it) === i).length);
        const omax = Math.max(1, fresh, ...open);
        const fmtDays = (x) => (x == null ? '—' : x < 1 ? A(`${Math.round(x * 24)} ساعة`, `${Math.round(x * 24)} h`) : A(`${x.toFixed(1)} يوم`, `${x.toFixed(1)} days`));
        const wlabel = (w) => new Date(w.end).toLocaleDateString(lang === 'ar' ? 'ar-EG-u-nu-latn' : 'en-GB', { day: 'numeric', month: 'short' });
        return `<section class="pagehead"><h1 style="font-size:26px">${A('الأرقام', 'Insights')}</h1><p class="muted">${A('من السجلات بس: أوقات الإنشاء والإنجاز وتشغيلات التحقق.', 'From records only: creation and completion times and verification runs.')}</p></section>
          <section class="kpis"><div class="kpi panel"><span class="tiny muted">${A('خلص آخر 30 يوم', 'Done in the last 30 days')}</span><b>${last30}</b></div><div class="kpi panel"><span class="tiny muted">${A('متوسط المدة من الطلب لـ«خلص» (الوسيط)', 'Median time from request to Done')}</span><b>${fmtDays(median)}</b><span class="tiny muted">${A(`من ${cycles.length} شغلانة`, `over ${cycles.length} items`)}</span></div><div class="kpi panel"><span class="tiny muted">${A('تشغيلات تحقق نجحت', 'Verification runs passed')}</span>${runs.total ? `<b>${Math.round((runs.passed / runs.total) * 100)}%</b><span class="tiny muted">${runs.passed} / ${runs.total}</span>` : `<b class="kpi-empty">—</b><span class="tiny muted">${A('لسه مفيش تشغيلات تحقق', 'No verification runs yet')}</span>`}</div><div class="kpi panel"><span class="tiny muted">${A('شغل مفتوح', 'Open work')}</span><b>${live.length}</b></div></section>
          <section class="charts"><article class="panel"><h2 style="font-size:18px">${A('اللي وصل «خلص» كل أسبوع', 'Reached Done per week')} <span class="tiny muted">${A('(آخر 8 أسابيع)', '(last 8 weeks)')}</span></h2>
            ${doneItems.length ? `<div class="cols">${weeks.map((w) => `<span class="col" data-tip="${esc(wlabel(w))}: ${w.n}"><i style="height:${(w.n / wmax) * 100}%"></i></span>`).join('')}</div><div class="row tiny muted cols-x"><span>${esc(wlabel(weeks[0]))}</span><span class="grow"></span><span>${esc(wlabel(weeks[7]))}</span></div>
            <details style="margin-top:10px"><summary class="tiny muted">${A('اعرض كجدول', 'Show as a table')}</summary><div class="tablewrap"><table><tr><th>${A('الأسبوع المنتهي', 'Week ending')}</th><th>${A('خلص', 'Done')}</th></tr>${weeks.map((w) => `<tr><td>${esc(wlabel(w))}</td><td>${w.n}</td></tr>`).join('')}</table></div></details>` : `<p class="small muted">${A('لسه مفيش شغل وصل «خلص». الرسم ده هيظهر أول ما شغلانة تخلص بتحقق.', 'Nothing has reached Done yet. This chart appears once a work item is finished with verification.')}</p>`}</article>
          <article class="panel"><h2 style="font-size:18px">${A('الشغل المفتوح في كل محطة', 'Open work by station')}</h2>${live.length ? `<div class="hbars">${fresh ? `<div class="hb" data-tip="${A('جديد (لسه متصنّفش)', 'New (not classified yet)')}: ${fresh}"><span class="lab">${A('جديد', 'New')}</span><span class="track"><i style="width:${(fresh / omax) * 100}%;--hue:var(--muted)"></i></span><b>${fresh}</b></div>` : ''}${open.map((n, i) => `<div class="hb" data-tip="${esc(L(ST[i].name))}: ${n}"><span class="lab">${L(ST[i].name)}</span><span class="track"><i style="width:${(n / omax) * 100}%;--hue:${ST[i].hue}"></i></span><b>${n}</b></div>`).join('')}</div>${fresh ? `<p class="tiny muted" style="margin-top:8px">${A('الشغل الجديد بيدخل محطة لما وكيلك يصنّفه.', 'New work enters a station once your agent classifies it.')}</p>` : ''}` : `<p class="small muted">${A('مفيش شغل مفتوح دلوقتي.', 'No open work right now.')}</p>`}</article></section>
          <p class="tiny muted" style="margin-top:14px">${A('YallaFlow مش بيسجّل وقت كل محطة ولا وقت الانتظار، فمش بنعرضهم.', 'YallaFlow does not record time per station or waiting time, so they are not shown.')}</p>`;
      }
    
      // ---------- Create Work: the console's only write (Core's start/route/intake add) ----------
      const ACCEPT = '.md,.txt,.rst,.pdf,.docx,.pptx,.xlsx,.rtf,.odt,.ods,.odp,.csv,.json,.yaml,.yml,.png,.jpg,.jpeg,.gif,.webp';
      const KINDS = [['', { ar: 'خلّي الوكيل يحدد', en: 'Let my agent decide' }], ['feature', TYPE.feature], ['bug', TYPE.bug], ['change', TYPE.change], ['investigation', TYPE.investigation]];
      const SIZES = [['bounded', { ar: 'صغير', en: 'Small' }, 'bounded'], ['architectural', { ar: 'كبير', en: 'Large' }, 'architectural'], ['spike', { ar: 'استكشافي', en: 'Exploratory' }, 'spike']];
      let cw = null; // { requestId, pid, created, files, failed }
      const newRequestId = () => (crypto.randomUUID ? crypto.randomUUID() : Array.from(crypto.getRandomValues(new Uint8Array(16)), (b) => b.toString(16).padStart(2, '0')).join(''));
      async function post(pathname, body, headers) {
        const response = await reach(() => fetch(pathname, { method: 'POST', headers: { Authorization: `Bearer ${token}`, ...headers }, body, cache: 'no-store' }));
        let data = null;
        try { data = await response.json(); } catch { /* not json */ }
        if (!response.ok) throw Object.assign(new Error(data?.error?.message ?? `HTTP ${response.status}`), { status: response.status, code: data?.error?.code, data, messageAr: data?.error?.messageAr ?? null });
        return data;
      }
      // The server's reason in the reader's language for the common cases; Core's own text otherwise.
      function why(e, file) {
        const name = file ? `«${file.name}»` : '';
        const known = {
          UNSUPPORTED_FILE: A(`نوع الملف ${name} مش مدعوم هنا. المدعوم: PDF وWord وExcel وPowerPoint والنصوص والصور.`, `${file?.name ?? 'This file'} is not a supported type here. Supported: PDF, Word, Excel, PowerPoint, text and images.`),
          TOO_LARGE: A(`الملف ${name} أكبر من 50 MB، أقصى حجم YallaFlow يقدر يقرا نصه.`, `${file?.name ?? 'The file'} is larger than 50 MB, the most YallaFlow can still read as text.`),
          EMPTY_FILE: A(`الملف ${name} فاضي.`, `${file?.name ?? 'The file'} is empty.`),
          WORKSPACE_BUSY: A('أمر YallaFlow تاني شغّال في المشروع دلوقتي. جرّب تاني بعد شوية.', 'Another YallaFlow command is busy in this project. Try again in a moment.')
        };
        if (!e.status) return A('الكونسول مش متاح. اتأكد إنه لسه شغّال وجرّب تاني.', 'The console is not reachable. Check that it is still running and try again.');
        return known[e.code] ?? (lang === 'ar' && e.messageAr ? e.messageAr : e.message);
      }
      // PF-0112 Phase 2: the server's Arabic copy of an execution message, in the Arabic console.
      const tr = (item, key = 'text') => (lang === 'ar' && item?.[`${key}Ar`] ? item[`${key}Ar`] : item?.[key] ?? '');
      const trDir = (item, key = 'text') => (lang === 'ar' && !item?.[`${key}Ar`] ? ' dir="ltr"' : '');
      // Escaped HTML of a message; in an Arabic sentence, each run of Latin text (a path, a command,
      // a branch) is isolated left-to-right, so it is never reordered by the Arabic around it.
      const trHtml = (item, key = 'text') => {
        const html = esc(tr(item, key));
        return lang === 'ar' && item?.[`${key}Ar`] ? html.replace(/[A-Za-z0-9_\/.\-"'@:=(),%+&;#~*[\]{}<>!?]+(?:\s+[A-Za-z0-9_\/.\-"'@:=(),%+&;#~*[\]{}<>!?]+)*/g, (run) => `<bdi dir="ltr">${run}</bdi>`) : html;
      };
      const retryable = (e) => !e.status || e.status === 503;
      const fileQueues = new WeakMap();
      function attachmentFields() {
        return `<section class="request-files"><label class="fld"><span>${A('مرفقات (اختياري)', 'Attachments (optional)')}</span><input type="file" data-request-files multiple accept="${ACCEPT}"></label><p class="tiny muted">${A('اختار ملفات أو الصق صورة بـ Ctrl+V داخل الطلب · لحد 50 MB للملف.', 'Choose files or paste a screenshot with Ctrl+V inside the request · up to 50 MB each.')}</p><ul class="pending-files" data-pending-files></ul><p class="tiny" data-file-note role="status" aria-live="polite"></p></section>`;
      }
      function renderPendingFiles(form) {
        const state = fileQueues.get(form);
        form.querySelector('[data-pending-files]').innerHTML = state.entries.map((entry, i) => `<li>${entry.url ? `<img src="${esc(entry.url)}" alt="" width="56" height="44">` : '<span aria-hidden="true">📎</span>'}<span class="grow"><b dir="auto">${esc(entry.file.name)}</b><small class="muted">${size(entry.file.size)}${entry.uploaded ? ` · ✓ ${A('اتضاف', 'Attached')}` : ''}</small>${entry.error ? `<small class="file-error">${esc(entry.error)}</small>` : ''}</span>${entry.uploaded ? '' : `<button type="button" class="ibtn" data-remove-file="${i}" aria-label="${esc(A(`احذف ${entry.file.name}`, `Remove ${entry.file.name}`))}" ${form.dataset.busy ? 'disabled' : ''}>✕</button>`}</li>`).join('');
      }
      function addRequestFiles(form, files, pasted = false) {
        const state = fileQueues.get(form);
        if (!state || form.dataset.busy) return;
        const problems = [];
        for (let file of files) {
          if (pasted) {
            const ext = { 'image/png': 'png', 'image/jpeg': 'jpg', 'image/gif': 'gif', 'image/webp': 'webp' }[file.type];
            if (!ext) { problems.push(A('نوع الصورة مش مدعوم. اختار PNG أو JPG أو GIF أو WebP.', 'Use a PNG, JPG, GIF or WebP image.')); continue; }
            file = new File([file], `screenshot-${Date.now()}-${++state.sequence}.${ext}`, { type: file.type });
          }
          const ext = '.' + file.name.split('.').pop().toLowerCase();
          const code = !ACCEPT.split(',').includes(ext) ? 'UNSUPPORTED_FILE' : !file.size ? 'EMPTY_FILE' : file.size > 50 * 1024 * 1024 ? 'TOO_LARGE' : null;
          if (code) { problems.push(why({ status: 422, code }, file)); continue; }
          state.entries.push({ file, url: /^image\/(png|jpeg|gif|webp)$/.test(file.type) ? URL.createObjectURL(file) : null, uploaded: false, error: null });
        }
        renderPendingFiles(form);
        form.querySelector('[data-file-note]').textContent = problems.join(' ') || A(`${state.entries.length} مرفق جاهز.`, `${state.entries.length} attachment(s) ready.`);
      }
      function initRequestFiles(form) {
        fileQueues.set(form, { entries: [], sequence: 0, requestId: newRequestId() });
        form.addEventListener('paste', (event) => {
          if (form.dataset.busy) return;
          const files = [...(event.clipboardData?.items ?? [])].filter((item) => item.kind === 'file').map((item) => item.getAsFile()).filter(Boolean);
          if (!files.length) files.push(...(event.clipboardData?.files ?? []));
          if (!files.length) return; // ordinary text paste remains native
          event.preventDefault(); addRequestFiles(form, files, true);
        });
        form.querySelector('[data-request-files]').addEventListener('change', (event) => {
          addRequestFiles(form, [...event.target.files]); event.target.value = '';
        });
        form.addEventListener('click', (event) => {
          const button = event.target.closest('[data-remove-file]');
          if (!button || form.dataset.busy) return;
          const state = fileQueues.get(form), index = Number(button.dataset.removeFile);
          const entry = state.entries[index];
          if (!entry || entry.uploaded) return;
          if (entry.url) URL.revokeObjectURL(entry.url);
          state.entries.splice(index, 1); renderPendingFiles(form);
          form.querySelector('[data-file-note]').textContent = A('المرفق اتشال من الطلب.', 'Attachment removed from the request.');
          form.querySelector('[data-request-files]').focus();
        });
        const dialog = form.closest('dialog');
        dialog.addEventListener('cancel', (event) => { if (form.dataset.busy) event.preventDefault(); });
        dialog.addEventListener('close', () => { for (const entry of fileQueues.get(form)?.entries ?? []) if (entry.url) URL.revokeObjectURL(entry.url); fileQueues.delete(form); });
      }
      function requestBusy(form, busy) {
        if (busy) {
          form.dataset.busy = 'true';
          form._enabledControls = [...form.querySelectorAll('input,textarea,select,button')].filter((el) => !el.disabled);
          for (const el of form._enabledControls) el.disabled = true;
        } else {
          delete form.dataset.busy;
          for (const el of form._enabledControls ?? []) el.disabled = false;
          delete form._enabledControls;
        }
      }
      async function uploadRevisionFiles(form, projectId, id) {
        const state = fileQueues.get(form);
        for (const entry of state.entries.filter((entry) => !entry.uploaded)) {
          entry.error = null;
          try {
            await post(`/api/p/${projectId}/work/${encodeURIComponent(id)}/revision-sources`, entry.file, { 'Content-Type': 'application/octet-stream', 'X-File-Name': encodeURIComponent(entry.file.name), 'X-Request-Id': state.requestId });
