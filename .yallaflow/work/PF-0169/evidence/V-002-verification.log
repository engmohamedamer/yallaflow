              ${rv.notCovered?.length ? `<p class="tiny">${A('غير مشمول:', 'Not covered:')} ${rv.notCovered.map((x) => `<span class="ltr">${esc(x.what)}</span> — ${esc(x.why)}`).join(' · ')}</p>` : ''}</details></article>`;
        };
