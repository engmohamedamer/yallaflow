        error: { ar: 'وقف بسبب خطأ', en: 'stopped on an error' },
        crashed: { ar: 'وقف فجأة', en: 'stopped unexpectedly' },
        ended: { ar: 'جلسته اتقفلت', en: 'had its session ended' },
