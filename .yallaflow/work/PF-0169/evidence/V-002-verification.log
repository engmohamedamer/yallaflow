        const unread = t.readError ? `<p class="tiny warn" role="alert" data-chat-read-error>${A('جزء من المحادثة المحفوظة لم يُقرأ:', 'Part of the saved conversation was not read:')} <span dir="ltr">${esc(t.readError)}</span></p>` : '';
        const on = t.saved !== false;
        const keep = `<details class="chatkeep" data-steps="chat-keep" data-chat-keep ${chatStepsOpen.has('chat-keep') ? 'open' : ''}><summary class="tiny muted">${on ? A('المحادثة تُحفظ على هذا الجهاز', 'This chat is saved on this machine') : A('حفظ المحادثة متوقف', 'Saving the chat is off')}</summary><div class="tiny"><p class="muted">${A('تُحفظ داخل هذا المشروع في <span dir="ltr">.yallaflow/local/agent-chat</span>: خارج Git، ولا يقرؤها غيرك على هذا الجهاز. القيم التي تشبه كلمات السر والمفاتيح تُخفى قبل الحفظ، لكن هذا لا يضمن إخفاء كل سر.', 'It is kept inside this project in <span dir="ltr">.yallaflow/local/agent-chat</span>: outside Git and readable only by you on this machine. Values that look like passwords or keys are hidden before saving, but that does not guarantee every secret is caught.')}</p><label class="optin"><input type="checkbox" data-chat-save-toggle ${on ? 'checked' : ''}> ${A('احفظ الرسائل الجديدة على هذا الجهاز (لكل المشاريع)', 'Save new messages on this machine (all projects)')}</label>${on ? '' : `<p class="muted" data-chat-save-off>${A('الرسائل الجديدة تبقى حتى إغلاق الكونسول فقط. ما حُفظ من قبل باقٍ كما هو؛ امسحه بالزر أدناه إن أردت.', 'New messages stay only until the console is closed. What was saved before is kept as it is; delete it with the button below if you want.')}</p>`}<button type="button" class="btn sm ghost danger" data-chat-clear>${A('امسح المحادثة المحفوظة لهذا المشروع…', 'Delete this project\'s saved chat…')}</button></div></details>`;
        return `${failed}${unread}${keep}`;
      }
      function agentPanel(it) {
        // PF-0133: no agent chosen for this project yet — choose it here, first.
        if (!readOnly && agentStep()?.status === 'choose') return `<section class="panel agent" id="agent"><div class="ahead"><h2>${A('اختار وكيل المشروع', 'Choose the project\'s agent')}</h2></div><p class="small muted">${A('أول خطوة: اختار الوكيل اللي هيشتغل على المشروع ده.', 'First step: choose the agent that works on this project.')}</p>${agentChooser()}</section>`;
        if (!agentsOn) return agentOffPanel(it);
        // PF-0165: a failed first load is said, with a way to try again (it used to read "Loading" forever).
        if ((!agent || agent.pid !== pid) && agentError) return `<section class="panel agent" id="agent"><div class="errbar data small" role="alert"><b>${A('تعذّر تحميل المحادثة', 'The chat could not be loaded')}</b><p class="small" dir="auto">${esc(agentError)}</p><button type="button" class="btn sm" data-agent-retry>${A('حاول مرة أخرى', 'Try again')}</button></div><p class="tiny muted">${A('الرسائل المحفوظة لم تُحذف؛ التحميل فقط هو الذي فشل.', 'Saved messages were not deleted; only loading them failed.')}</p></section>`;
        if (!agent || agent.pid !== pid) return `<section class="panel agent" id="agent"><p class="muted">${A('بيحمّل مساحة الوكيل…', 'Loading the agent workspace…')}</p></section>`;
        const s = agent.session;
        const provider = (id) => agent.providers.find((p) => p.id === id);
        const isActive = !it.project && snap?.project?.activeWork === it.id;
        const activation = it.project ? `<span class="tiny muted">${A('شات المشروع: مش مربوط بشغلانة. أي تعديل الوكيل هيفتحله شغلانة الأول.', 'Project chat: not tied to a work item. The agent routes any change to a work item first.')}</span>` : isActive ? `<span class="chip done"><i></i>${A('الشغلانة النشطة', 'Active work item')}</span>` : `<span class="tiny muted">${A('مش الشغلانة النشطة.', 'Not the active work item.')}</span> <button class="btn sm ghost" data-agent-activate="${esc(it.id)}">${A('خلّيها النشطة', 'Make it active')}</button>`;
        const head = `<div class="ahead"><h2>${A('الوكيل', 'Agent')}</h2><span class="grow"></span>${activation}</div>`;
        const err = agentError ? `<div class="errbar data small">${esc(agentError)}</div>` : '';
        if (!s && agent.lockedBy) return `<section class="panel agent" id="agent">${head}${err}<div class="awarn" role="status">${A('جلسات الوكيل في النسخة دي من المشروع تبع كونسول YallaFlow تاني شغّال. استخدمه، أو اقفله الأول.', 'Agent sessions in this checkout belong to another running YallaFlow console. Use that console, or stop it first.')}</div><p class="tiny muted" dir="ltr">${esc(agent.lockedBy.message)}</p></section>`;
        if (!s || (s.workId && s.workId !== it.id && (s.provider === 'codex' || it.project))) {
          if (s) return `<section class="panel agent" id="agent">${head}${err}<p class="small">${A(`فيه جلسة ${PROVIDER[s.provider]} شغّالة على`, `A ${PROVIDER[s.provider]} session is active for`)} <a href="#/item/${encodeURIComponent(s.workId)}" class="ltr">${esc(s.workId)}</a>. ${A('جلسة واحدة بس في كل نسخة من المشروع.', 'Only one agent session runs per checkout.')}</p>${planAwaitAgent?.pid === pid && planAwaitAgent.sentTo ? `<p class="small" role="status">${A(`طلب تجهيز التشغيل اتبعت للجلسة دي على ${esc(s.workId)}. الاقتراح هيظهر في صفحة «التشغيل» لوحده، والرد في شات ${esc(s.workId)}.`, `The run setup request was sent to this session on ${esc(s.workId)}. The proposal appears on the Run page by itself; the reply is in ${esc(s.workId)}'s chat.`)}</p>` : ''}${switchHere(it, s)}</section>`;
          // PF-0134: the chat opens on the agent chosen for this project and lists only it.
          const chosenHere = agentStep()?.status && agentStep().status !== 'choose' ? agentStep().provider : null;
          const choice = agentProvider ?? (chosenHere && provider(chosenHere) ? chosenHere : null) ?? agent.providers.find((p) => p.ready)?.id ?? 'codex';
          const p = provider(choice);
          const listed = chosenHere && provider(chosenHere) && !agentProvider ? agent.providers.filter((x) => x.id === chosenHere) : agent.providers;
          const other = chosenHere && !agentProvider && !readOnly ? (chosenHere === 'claude' ? 'codex' : agentsClaudeAvailable ? 'claude' : null) : null;
          const otherLink = other ? `<p class="tiny muted">${A('وكيل المشروع ده', 'This project\'s agent')}: <b>${PROVIDER[chosenHere]}</b> · <button type="button" class="linkbtn" data-agent-choose="${other}">${A(`استخدم ${PROVIDER[other]} بداله`, `Use ${PROVIDER[other]} instead`)}</button></p>` : '';
          const picks = listed.map((x) => `<label class="apick ${x.ready ? '' : 'off'}"><input type="radio" name="agentProvider" value="${x.id}" ${x.id === choice ? 'checked' : ''}><span><b>${PROVIDER[x.id]}</b>${x.experimental ? ` <i class="exp">${A('تجريبي', 'experimental')}</i>` : ''}<small>${x.ready ? (x.id === 'codex' ? A('اشتراك ChatGPT بتاعك', 'Your ChatGPT subscription') : A(`اشتراك Claude بتاعك${x.auth?.plan ? ` (${x.auth.plan})` : ''}`, `Your Claude subscription${x.auth?.plan ? ` (${x.auth.plan})` : ''}`)) : A('مش جاهز', 'Not ready')}</small></span></label>`).join('');
          const problems = (p && !p.ready ? `<ul class="aprob">${p.problems.map((x) => `<li>${esc(x)}</li>`).join('')}</ul>` : '');
          let action = '';
          if (p?.ready && p.capabilities.start) action = `<div class="row"><label class="small">${A('الصلاحيات', 'Permissions')} <select data-agent-mode>${p.capabilities.modes.map((m) => `<option value="${m}" ${m === agentMode ? 'selected' : ''}>${L(MODE_LABEL[m])}</option>`).join('')}</select></label><span class="grow"></span><button class="btn go" data-agent-start ${agentBusy ? 'disabled' : ''}>${A('ابدأ جلسة Codex', 'Start Codex session')}</button></div>${agent.resumable.length ? `<div class="tiny muted">${A('جلسات سابقة:', 'Earlier sessions:')} ${agent.resumable.map((r) => `<button class="linkbtn" data-agent-resume="${esc(r.id)}">${esc(r.workId ?? '—')} · ${ago(r.startedAt)}</button>`).join(' ')}</div>` : ''}`;
          else if (p?.ready && p.id === 'claude') action = `<div class="row"><span class="small grow">${A('Claude Code بيشتغل في الترمينال بتاعك باشتراكك. YallaFlow بيتوصّل بيه بس، مش بيشغّله.', 'Claude Code runs in your terminal with your subscription. YallaFlow connects to it; it never runs it.')}</span><button class="btn go" data-agent-connect ${agentBusy ? 'disabled' : ''}>${A('وصّل Claude Code', 'Connect Claude Code')}</button></div>`;
          // PF-0072: a prepared message (for example the runtime plan request) waits for a session.
          const waiting = agentDraft.trim() ? `<div class="anote" role="status" data-draft-waiting><b class="small">${A('فيه رسالة جاهزة مستنية', 'A prepared message is waiting')}</b><p class="tiny">${A('ابدأ جلسة أو وصّل Claude Code، وهتلاقيها في خانة الكتابة تراجعها وتبعتها بنفسك. مفيش حاجة اتبعتت.', 'Start a session or connect Claude Code and it will be in the message box for you to review and send. Nothing was sent.')}</p><details><summary class="tiny">${A('اعرض الرسالة', 'Show the message')}</summary><pre class="cli small" dir="ltr" style="white-space:pre-wrap">${esc(agentDraft)}</pre></details></div>` : '';
          // PF-0165: the conversation stays readable after its session ended (it used to vanish here).
          const past = chatEntriesHtml();
          const earlier = past ? `<div class="apast" data-chat-past><p class="tiny muted">${A('المحادثة السابقة في هذا المشروع (للقراءة؛ ابدأ جلسة لتكمل):', 'The earlier conversation in this project (to read; start a session to continue):')}</p><div class="astream" aria-label="${A('المحادثة السابقة', 'Earlier conversation')}">${chatOlderBar()}${past}</div>${chatSaveNote()}</div>` : '';
          return `<section class="panel agent" id="agent">${head}${err}${earlier}${stopCard(it)}${waiting}${chatJump()}<div class="apicks">${picks}</div>${otherLink}${problems}${action}${otherLink ? '' : setupHint()}<p class="tiny muted">${A('الوكيل بيستخدم اشتراكك الموجود بس، من غير مفاتيح API. أذونات الأدوات مش موافقات YallaFlow.', 'Agents use only your existing subscription, never API keys. Tool permissions are not YallaFlow approvals.')}</p></section>`;
        }
        const cap = provider(s.provider)?.capabilities ?? {};
        const modeChip = s.mode ? `<span class="chip ${autoApproves(s.mode) ? 'wait' : 'todo'}" title="${esc(L(MODE_LABEL[s.mode] ?? { ar: esc(s.mode), en: esc(s.mode) }))}">${esc(s.mode)}</span>` : '';
        const warn = isForbidden(s.mode) ? `<div class="awarn" role="alert">⛔ ${esc(L(MODE_LABEL.bypassPermissions))}. ${A('غيّر الوضع من Claude Code.', 'Change the mode in Claude Code.')}</div>` : autoApproves(s.mode) ? `<div class="awarn">⚠ ${esc(L(MODE_LABEL[s.mode]))}. ${A('مش كل فعل هيظهر هنا كطلب إذن.', 'Not every action will appear here as a permission request.')}</div>` : '';
        // PF-0145: one connection state. The console sends to Claude Code itself only after the
        // connection check was acknowledged; otherwise it is Terminal mode, a normal way to work.
        const claude = s.provider === 'claude';
        const terminal = claude && s.connected && s.channel !== 'verified';
        const checking = terminal && s.channel === 'checking';
        const working = s.status === 'working';
        const state = claude && !s.connected ? A('في انتظار Claude Code', 'Waiting for Claude Code')
          : checking ? A('جارٍ التحقق من الاتصال…', 'Checking the connection…')
          : terminal ? (working ? A('وضع الترمينال · يعمل…', 'Terminal mode · working…') : A('وضع الترمينال', 'Terminal mode'))
          : working ? A('شغّال…', 'Working…') : s.status === 'starting' ? A('بيبدأ…', 'Starting…') : A('جاهز', 'Ready');
        const controls = [
          cap.stop && s.status === 'working' ? `<button class="btn sm ghost" data-agent-cancel>${A('وقّف', 'Stop')}</button>` : '',
          cap.end ? `<button class="btn sm ghost" data-agent-end>${A('اقفل الجلسة', 'End session')}</button>` : '',
          s.provider === 'claude' ? `<button class="btn sm ghost" data-agent-disconnect>${A('افصل من YallaFlow', 'Unlink')}</button>` : ''
        ].join('');
        const copyBlock = (text) => `<pre class="cli" dir="ltr">${esc(text)}</pre><button class="btn sm ghost" data-copy="${esc(text)}">${A('انسخ', 'Copy')}</button>`;
        // PF-0134: Connect opens Claude Code in a terminal; the developer only confirms its prompt there.
        const launch = s.provider === 'claude' && !s.connected && agentLaunch && agentTerminal?.opened
          ? `<div class="alaunch"><p class="small">${A('Claude Code اتفتح في ترمينال في فولدر المشروع. وافق على تحذير القناة التجريبية هناك، والشات هنا هيتوصّل لوحده.', 'Claude Code opened in a terminal in the project folder. Accept its development-channel prompt there; this chat connects by itself.')}</p><details class="tiny"><summary class="muted">${A('ما اتفتحش؟ شغّل الأمر بنفسك', 'Did not open? Run the command yourself')}</summary>${copyBlock(agentLaunch)}</details></div>`
          : s.provider === 'claude' && !s.connected && agentLaunch ? `<div class="alaunch">${agentTerminal?.error ? `<p class="tiny muted">${esc(agentTerminal.error)}</p>` : ''}<p class="small">${A('شغّل Claude Code بنفسك في فولدر المشروع بالأمر ده. Claude Code هيعرض تحذير القناة التجريبية والقرار ليك.', 'Start Claude Code yourself in the project folder with this command. Claude Code shows its own development-channel warning; the decision is yours.')}</p><pre class="cli" dir="ltr">${esc(agentLaunch)}</pre><button class="btn sm ghost" data-copy="${esc(agentLaunch)}">${A('انسخ', 'Copy')}</button></div>` : '';
        const entries = chatEntriesHtml();
        const canSend = cap.send && (s.provider === 'codex' ? s.status === 'idle' : s.connected);
        // PF-0105: before the first message on an item, the box holds the whole-job instruction.
        // PF-0154: an item waiting for the developer's answer or review is not started again:
        // no whole-job draft is seeded, and one seeded earlier and left untouched is dropped.
        if (it.waitingFor && !it.project && agentDraft === goText(it)) agentDraft = '';
        if (canSend && !it.project && !it.waitingFor && it.state !== 'done' && !agentDraft && !agentEntries(agent.events).some((e) => e.kind === 'user')) agentDraft = goText(it);
        const how = !claude || !s.connected ? ''
          : checking ? A('جارٍ التحقق من إمكانية الإرسال من الكونسول. إلى أن ينتهي، اكتب رسالتك وانسخها والصقها في ترمينال Claude Code.', 'Checking whether the console can send to Claude Code. Until then, write your message, copy it, and paste it in the Claude Code terminal.')
          : terminal ? `${A('اكتب رسالتك هنا، انسخها، ثم الصقها في ترمينال Claude Code.', 'Write your message here, copy it, then paste it in the Claude Code terminal.')} ${s.monitoring ? A('الكونسول يعرض العمل أولًا بأول.', 'The console shows the work as it happens.') : A('سيظهر العمل هنا عندما يبدأ Claude Code.', 'The work appears here once Claude Code starts.')}`
          : A('الإيقاف والإنهاء بيتعملوا من Claude Code نفسه (Esc). الردود بتوصل كرسايل كاملة.', 'Stop and end happen in Claude Code itself (Esc). Replies arrive as whole messages.');
        return `<section class="panel agent" id="agent">${head}${err}
          <div class="abar"><b>${PROVIDER[s.provider]}</b>${s.provider === 'claude' ? ` <i class="exp">${A('تجريبي', 'experimental')}</i>` : ''}<span class="chip active"><i></i>${esc(state)}</span>${s.auth ? `<span class="chip todo">${esc(s.auth)}</span>` : ''}${modeChip}<span class="grow"></span>${controls}</div>
          ${!it.project && !s.workId ? `<p class="tiny muted">${A('دي جلسة شات المشروع، مش مربوطة بالشغلانة دي.', 'This is the project chat session; it is not tied to this work item.')}</p>` : ''}${s.provider === 'claude' && !it.project ? switchHere(it, s) : ''}${warn}${stopCard(it)}${launch}
          <div class="astream" aria-live="polite">${chatOlderBar()}${entries || `<p class="tiny muted">${it.project ? A('اسأل الوكيل عن المشروع، مثلاً: «إيه اللي مستنيني؟».', 'Ask the agent about the project, for example: "What is waiting for me?".') : A(`اكتب للوكيل، مثلاً: «كمّل ${it.id}».`, `Message the agent, for example: "Continue ${it.id}".`)}</p>`}</div>
          ${chatSaveNote()}${chatJump()}${sessionHistory(it)}${suggestionChips(it, (agent.pending ?? []).length ? 'approval' : s.status === 'working' ? 'working' : canSend && agentEntries(agent.events).at(-1)?.kind === 'agent' ? 'reply' : null)}<form class="acompose" data-agent-form ${terminal ? 'data-terminal' : ''}><textarea data-agent-input rows="2" maxlength="20000" placeholder="${A(`اكتب لـ ${PROVIDER[s.provider]}…`, `Message ${PROVIDER[s.provider]}…`)}" ${canSend ? '' : 'disabled'}>${esc(agentDraft)}</textarea><button class="btn go" type="submit" ${canSend && !agentBusy ? '' : 'disabled'}>${terminal ? A('انسخ للترمينال', 'Copy for terminal') : A('ابعت', 'Send')}</button></form>
          ${how ? `<p class="tiny muted" data-agent-how>${how}</p>` : ''}</section>`;
      }
      // Returns false when the action failed. Its error survives the state reload that follows
      // (loadAgent clears agentError on success), so a refused send is never silent (PF-0065).
      async function agentAction(action, body, after) {
        agentBusy = true; agentError = null; renderAgent();
        let failed = null;
        try { const result = await agentPost(action, body); await after?.(result); } catch (e) { failed = e.message; }
        agentBusy = false;
        await loadAgent();
        if (failed) agentError = failed;
        renderAgent();
        return !failed;
      }
    
      // The one thing to do next, in plain words, from Core's verdict (never computed here).
      // ---------- work management (1.4.0): every action is Core's own command ----------
      // The console never decides a move: it asks Core (through the server) and shows Core's answer.
      const ACTION_LABEL = {
        activate: { ar: 'خلّيها النشطة', en: 'Make it active' }, advance: { ar: 'انقلها للمرحلة الجاية', en: 'Move to the next stage' },
        hold: { ar: 'وقّفها مؤقتًا…', en: 'Put on hold…' }, resume: { ar: 'كمّل الشغل عليها', en: 'Resume' },
        close: { ar: 'اقفلها من غير تسليم…', en: 'Close without delivery…' }, reopen: { ar: 'افتحها تاني…', en: 'Reopen…' },
        revise: { ar: 'عدّل الطلب…', en: 'Edit request…' }, answer: { ar: 'جاوب…', en: 'Answer…' }
      };
      function itemActions(it) {
        if (readOnly) return [];
        const lifecycle = it.lifecycle?.state;
        if (lifecycle === 'on_hold') return ['resume', 'close'];
        if (lifecycle === 'closed') return ['reopen'];
        if (it.state === 'done') return ['reopen'];
        const list = [];
        if (snap?.project?.activeWork !== it.id) list.push('activate');
        if (it.requestEditable) list.push('revise');
        if (it.routing !== 'pending' && !it.baselineStep) list.push('advance');
        if (it.waitingFor?.kind === 'question') list.push('answer');
        list.push('hold', 'close');
        return list;
      }
      function actionBar(it) {
        const acts = itemActions(it);
        if (!acts.length && !(it.waitingFor?.kind === 'review' && !readOnly)) return '';
        const blocked = it.blocker && it.state !== 'done' && !it.lifecycle;
        const gate = it.waitingFor?.kind === 'review' && !readOnly ? `<button class="btn sm go" data-gate="${esc(it.waitingFor.gate)}" data-gate-item="${esc(it.id)}">${A(`راجع وقرّر (${it.waitingFor.gate})`, `Review and decide (${it.waitingFor.gate})`)}</button>` : '';
        // PF-0092: the main actions stay visible; editing, holding and closing sit under «More».
        const SECONDARY = ['revise', 'hold', 'close'];
        const button = (a) => {
          const off = a === 'advance' && blocked;
          return `<button class="btn sm ${a === 'close' ? 'ghost danger' : 'ghost'}" data-act="${a}" data-act-item="${esc(it.id)}" ${off ? `aria-disabled="true" title="${esc(it.blocker)}"` : ''}>${L(ACTION_LABEL[a])}</button>`;
        };
        // PF-0093: moving the stage only works once the current stage's work is recorded, so the
        // button is hidden until then; the why line says, in words, whose turn it is.
        const main = acts.filter((a) => (!SECONDARY.includes(a) || it.lifecycle) && !(a === 'advance' && blocked));
        const more = acts.filter((a) => SECONDARY.includes(a) && !it.lifecycle);
        return `<section class="actbar" aria-label="${A('أفعال الشغلانة', 'Work item actions')}">${gate}${main.map(button).join('')}${more.length ? `<details class="actmore"><summary class="btn sm ghost">⋯ ${A('المزيد', 'More')}</summary><div class="actmenu">${more.map(button).join('')}</div></details>` : ''}${blocked && blockerText(it.blocker) !== nowText(it) ? `<p class="tiny muted why">${A('ليه لسه في المرحلة دي:', 'Why it is still at this stage:')} ${iso(blockerText(it.blocker))}${lang === 'ar' ? '' : it.nextAction ? ` · <span class="ltr">${esc(it.nextAction)}</span>` : ''}</p>` : ''}${it.lifecycle ? `<p class="tiny muted why">${esc(it.blocker ?? '')}</p>` : ''}</section>`;
      }
    
      // One dialog for every action; fields follow the action. Core's refusal is shown as-is.
      function actionFields(kind, it, request = '') {
        const area = (name, label, required = true) => `<label class="fld">${label}<textarea name="${name}" rows="3" maxlength="10000" ${required ? 'required' : ''}></textarea></label>`;
        if (kind === 'hold') return area('reason', A('السبب', 'Reason'));
        if (kind === 'resume') return area('note', A('ملاحظة (اختياري)', 'Note (optional)'), false);
        if (kind === 'revise') return `<p class="small muted">${A('تقدر تعدّل الطلب طالما الشغل لسه ما بدأش. النسخة القديمة والمرفقات هيفضلوا محفوظين.', 'You can edit the request until work starts. Previous versions and attachments are kept.')}</p><label class="fld">${A('الطلب بعد التعديل', 'Revised request')}<textarea name="text" rows="6" maxlength="20000" required>${esc(request)}</textarea></label>${area('reason', A('السبب', 'Reason'))}${attachmentFields()}`;
        if (kind === 'answer') {
          // PF-0143 (G4): each question is shown with its text, not only its id.
          const known = detail?.item?.id === it.id ? detail.questions ?? [] : [];
          const text = (q) => known.find((x) => x.id === q)?.question ?? '';
          const ids = it.waitingFor?.questions ?? [];
          return `<label class="fld">${A('السؤال', 'Question')}<select name="question" data-answer-pick>${ids.map((q) => `<option value="${esc(q)}">${esc(q)}${text(q) ? ` — ${esc(text(q).length > 90 ? `${text(q).slice(0, 89)}…` : text(q))}` : ''}</option>`).join('')}</select></label><div class="brief small" data-answer-text dir="auto">${esc(text(ids[0]) || A('بيحمّل نص السؤال…', 'Loading the question…'))}</div>${area('answer', A('الإجابة', 'Answer'))}`;
        }
        if (kind === 'close') return `<label class="fld">${A('النتيجة', 'Outcome')}<select name="outcome"><option value="cancelled">${A('اتلغت', 'Cancelled')}</option><option value="superseded">${A('اتبدّلت بشغلانة تانية', 'Superseded by another item')}</option><option value="duplicate">${A('مكررة', 'Duplicate of another item')}</option></select></label><label class="fld">${A('الشغلانة البديلة (للمستبدلة أو المكررة)', 'The other item (for superseded or duplicate)')}<input name="by" class="ltr" placeholder="PF-0000" pattern="PF-[A-Za-z0-9-]+"></label>${area('reason', A('السبب', 'Reason'))}<p class="tiny muted">${A('الشغل المقفول عمره ما بيتحسب متسلّم ولا متحقق منه.', 'Closed work is never counted as delivered or verified.')}</p>`;
        if (kind === 'reopen') return `${it.state === 'done' ? `<label class="fld">${A('افتحها على', 'Reopen to')}<select name="to"><option value="implementation">${A('التنفيذ', 'Implementation')}</option><option value="verification">${A('التحقق', 'Verification')}</option><option value="review">${A('المراجعة', 'Review')}</option></select></label>` : ''}${area('reason', A('السبب', 'Reason'))}`;
        return `<p>${A('YallaFlow هيشغّل الأمر ده دلوقتي.', 'YallaFlow runs this command now.')}</p>`;
      }
      function openAction(kind, id, preset = {}) {
        const it = byId(id);
        if (!it || readOnly) return;
        document.querySelector('dialog.act')?.remove();
        const d = document.createElement('dialog');
        d.className = 'create act';
        d.setAttribute('aria-labelledby', 'act-h');
        d.innerHTML = `<form data-act-form="${esc(kind)}" data-act-item="${esc(id)}" novalidate><div class="row"><h2 id="act-h" class="grow">${L(ACTION_LABEL[kind])}</h2><button type="button" class="btn ghost sm" data-act-cancel>${A('إلغاء', 'Cancel')}</button></div><p class="tiny muted ltr">${esc(id)} — ${esc(it.title)}</p>${actionFields(kind, it)}<div class="confirm" hidden></div><div class="errbar small" role="alert" hidden></div><div class="row"><span class="grow"></span><button class="btn go" type="submit">${L(ACTION_LABEL[kind]).replace('…', '')}</button></div></form>`;
        document.body.appendChild(d);
        d.addEventListener('close', () => d.remove());
        if (kind === 'answer') {
          // PF-0143 (G4): the question texts come from the item's own record (work show).
          const pick = d.querySelector('[data-answer-pick]');
          const box = d.querySelector('[data-answer-text]');
          let questions = detail?.item?.id === id ? detail.questions ?? [] : null;
          const show = () => { const q = (questions ?? []).find((x) => x.id === pick.value); box.textContent = q?.question ?? (questions ? A('النص مش متاح؛ اقراه في تبويب «الأسئلة والقرارات».', 'The text is not available; read it in the Questions & decisions tab.') : A('بيحمّل نص السؤال…', 'Loading the question…')); };
          pick.addEventListener('change', show);
          if (!questions) {
            const projectId = pid;
            api(`/api/p/${projectId}/work/${encodeURIComponent(id)}`).then((current) => {
              if (!d.isConnected || pid !== projectId) return;
              questions = current.questions ?? [];
              for (const option of pick.options) { const q = questions.find((x) => x.id === option.value); if (q?.question) option.textContent = `${q.id} — ${q.question.length > 90 ? `${q.question.slice(0, 89)}…` : q.question}`; }
              show();
            }).catch(() => { questions = []; if (d.isConnected) show(); });
          }
        }
        if (kind === 'revise') {
          initRequestFiles(d.querySelector('form'));
          const field = d.querySelector('[name="text"]');
          const submit = d.querySelector('button[type="submit"]');
          field.disabled = true;
          submit.disabled = true;
          field.placeholder = A('بيحمّل الطلب كامل…', 'Loading the full request…');
          const projectId = pid;
          api(`/api/p/${projectId}/work/${encodeURIComponent(id)}`).then((current) => {
            if (!d.isConnected) return;
            if (pid !== projectId) { d.close(); return; }
            if (!current.item.requestEditable) throw new Error(A('الشغل بدأ أو الطلب مش متاح للتعديل دلوقتي. حدّث الصفحة.', 'Work has started or this request is no longer editable. Refresh the page.'));
            field.value = current.request.raw ?? '';
            field.placeholder = '';
            field.disabled = false;
            submit.disabled = false;
            field.focus();
          }).catch((e) => {
            if (!d.isConnected) return;
            const err = d.querySelector('.errbar');
            err.hidden = false;
            err.textContent = why(e);
          });
        }
        for (const [name, value] of Object.entries(preset)) { const field = d.querySelector(`[name="${name}"]`); if (field) field.value = value; }
        d.showModal();
        d.querySelector('textarea, select, button[type="submit"]')?.focus();
      }
      async function submitAction(form) {
        if (form.dataset.busy) return;
        const projectId = pid;
        const kind = form.dataset.actForm;
        const id = form.dataset.actItem;
        const body = {};
        for (const field of form.querySelectorAll('[name]')) if (field.value.trim()) body[field.name] = field.value.trim();
        if (form.querySelector('[name="confirmMinimumVersion"]')?.checked) body.confirmMinimumVersion = true;
        const err = form.querySelector('.errbar');
        err.hidden = true;
        requestBusy(form, true);
        try {
          const serialized = JSON.stringify(body);
          if (kind !== 'revise' || form._savedRevision !== serialized) {
            await post(`/api/p/${projectId}/work/${encodeURIComponent(id)}/actions/${kind}`, serialized, { 'Content-Type': 'application/json' });
            if (kind === 'revise') form._savedRevision = serialized;
          }
          if (kind === 'revise' && !await uploadRevisionFiles(form, projectId, id)) {
            err.hidden = false;
            err.textContent = A('نص الطلب اتحفظ، لكن بعض المرفقات ماترفعتش. جرّب الحفظ تاني لإعادة رفعها، أو احذفها.', 'The request text was saved, but some attachments failed. Save again to retry them, or remove them.');
            return;
          }
