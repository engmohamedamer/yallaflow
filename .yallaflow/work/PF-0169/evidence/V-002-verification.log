        const usual = preferredAgentId();
        const mark = (id) => (usual === id ? ` <span class="chip active tiny" data-usual-agent="${id}">${A('وكيلك المعتاد', 'your usual agent')}</span>` : '');
        const codexCard = card('codex', 'Codex', A('اشتراك ChatGPT بتاعك · الموصى بيه', 'Your ChatGPT subscription · recommended'), mark('codex'));
        const claudeCard = agentsClaudeAvailable
          ? card('claude', `Claude Code <span class="chip wait tiny">${A('تجريبي', 'experimental')}</span>`, A('اشتراك Claude بتاعك', 'Your Claude subscription'), mark('claude'))
          : '';
        return `<div class="agentpick" role="group" aria-label="${A('اختار وكيل المشروع', 'Choose the project\'s agent')}">${usual === 'claude' ? claudeCard + codexCard : codexCard + claudeCard}</div>${usual ? `<p class="tiny muted">${A('اختيارك المعتاد محدّد أولاً. لن يُفعَّل لهذا المشروع إلا عندما تضغط عليه.', 'Your usual choice is listed first. It is enabled for this project only when you click it.')}</p>` : ''}
          <p class="tiny muted agentpick-note">${A('الاختيار بيتحفظ للمشروع ده على جهازك بس، وتقدر تغيّره من الإعدادات ← الوكلاء. الوكيل بيستخدم اشتراكك، من غير مفاتيح API.', 'The choice is saved for this project on this machine only; change it under Settings → Agents. The agent uses your subscription, never API keys.')}</p>`;
      }
      async function chooseAgent(provider, el) {
        if (el) el.disabled = true;
        try {
          await post(`/api/p/${pid}/agents/settings`, JSON.stringify({ agents: true, claude: provider === 'claude' }), { 'Content-Type': 'application/json' });
          await post(`/api/p/${pid}/setup/step`, JSON.stringify({ step: 'agents' }), { 'Content-Type': 'application/json' }).catch(() => {});
          agentsOn = true;
          savePrefs({ preferredAgent: provider }); // PF-0160: remembered as the usual agent
          if (provider === 'claude') agentProvider = 'claude';
          await reloadProjects().catch(() => {});
          await Promise.all([loadReadiness(), agentsOn ? loadAgent().catch(() => {}) : loadAgentInfo()]);
          toast(esc(provider === 'claude' ? A('Claude Code بقى وكيل المشروع ده ✓', 'Claude Code is now this project\'s agent ✓') : A('Codex بقى وكيل المشروع ده ✓', 'Codex is now this project\'s agent ✓')));
        } catch (err) { toast(esc(why(err))); }
        finally { if (el) el.disabled = false; render(); }
      }
      function readinessAction(st) {
        if (st.id === 'agent' && st.status === 'choose') return agentChooser();
        const btn = (attrs, label, go = false) => `<button type="button" class="btn sm ${go ? 'go' : ''}" ${attrs}>${label}</button>`;
        if (readOnly && st.status !== 'done') return st.next?.command ? `<code class="ltr tw:text-xs">${esc(st.next.command)}</code>` : '';
        if (st.id === 'initialized' && st.status === 'attention') return `<code class="ltr tw:text-xs">yallaflow doctor</code>`;
        if (st.id === 'understanding') {
          if (st.status === 'awaiting-review' && st.baselineId) return `<a class="btn sm go" href="#/item/${encodeURIComponent(st.baselineId)}">${A('راجع المسودة', 'Review the draft')}</a>`;
          if (st.status === 'required' || st.status === 'in-progress') {
            const first = st.status === 'required' ? firstRequest() : null;
            if (st.status !== 'required' && firstRequest()) store.set(firstRequestKey(pid), null);
            const ask = st.status === 'required' ? A('جهّز فهم للمشروع ده بأدلة من المستودع، وبعدها اعرضه عليّا عشان أوافق.', 'Establish project understanding for this repository, then show it to me for approval.') + (first ? A(` أول طلب لي بعدها: «${first}».`, ` My first request after that: "${first}".`) : '') : A('كمّل تجهيز فهم المشروع.', 'Continue the project-understanding discovery.');
            const ready = agentsOn && readiness?.data?.allows?.agentSessions;
            return ready ? btn(`data-ready-chat="${esc(ask)}"`, st.status === 'required' ? A('ابدأ مع الوكيل', 'Start with the agent') : A('كمّل مع الوكيل', 'Continue with the agent'), true)
              : `<button type="button" class="btn sm" data-copy="${esc(ask)}" data-copy-what="text" title="${esc(ask)}">${A('انسخ الطلب لوكيلك', 'Copy the request for your agent')}</button>`;
          }
        }
        if (st.id === 'agent' && st.status === 'off' && agentsCanEnable) return btn('data-agents-enable', A('شغّل الوكلاء', 'Turn agents on'), true);
        if (st.id === 'agent' && st.status === 'missing') return `<a class="btn sm" href="#/settings/agents" data-setup-jump="agents">${A('جهّز Codex', 'Set up Codex')}</a>`;
        if (st.id === 'runtime' && st.status !== 'done') return `<a class="btn sm ghost" href="#/run" data-run-next="${esc(st.status)}">${st.status === 'not-configured' ? A('جهّز تشغيل التطبيق', 'Get the app running') : st.status === 'stopped' ? A('شغّل التطبيق', 'Start the app') : A('افتح التشغيل', 'Open Run')}</a>`;
        return '';
      }
      // PF-0150: where the understanding stands, from the baseline's own records: its step, the
