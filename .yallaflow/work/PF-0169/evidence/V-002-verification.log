        if (now !== was) { if (kind === 'port') body.readyPort = Number(get('readyPort')); else if (kind === 'log') body.readyLog = get('readyLog'); else body.noReady = true; }
        return body;
      }
      async function submitEdit(form) {
        const id = form.dataset.svcEditform;
        const sv = runtime?.data?.services.find((x) => x.id === id);
        if (!sv || readOnly) return;
        const body = editPatch(sv, form);
        svcEdit[id] = { adv: Boolean(form.querySelector('.svcedit-adv')?.open), error: null };
        if (!Object.keys(body).length) { svcEdit[id].error = A('لم تغيّر شيئاً.', 'You did not change anything.'); return render(); }
        if (body.argv && !body.argv.length) { svcEdit[id].error = A('اكتب أمر التشغيل.', 'Type the start command.'); return render(); }
        body.scope = form.querySelector('[name="scope"]:checked')?.value ?? form.querySelector('[name="scope"]')?.value ?? 'local';
        runtimeBusy[id] = 'edit'; render();
        try {
          const done = await post(`/api/p/${pid}/runtime/${encodeURIComponent(id)}/edit`, JSON.stringify(body), { 'Content-Type': 'application/json' });
          delete svcEdit[id]; delete runtimeReview[id];
          toast(esc(`${A('تم تعديل الخدمة.', 'The service was changed.')} ${savedWhere(done)}`));
        } catch (e) { svcEdit[id].error = e.message; }
        runtimeBusy[id] = null;
        await loadRuntime(); render();
      }
      async function submitPort(form) {
        const id = form.dataset.svcPortform;
        const fx = rtFix[id];
        if (!fx || readOnly) return;
        const to = Number(form.querySelector('[name="to"]')?.value);
        const scope = form.querySelector('[name="scope"]:checked')?.value ?? form.querySelector('[name="scope"]')?.value ?? 'local';
        fx.error = null; fx.cannot = false; fx.suggestion = to || fx.suggestion;
        runtimeBusy[id] = 'port'; render();
        try {
          const done = await post(`/api/p/${pid}/runtime/${encodeURIComponent(id)}/port`, JSON.stringify({ from: fx.port, to, scope }), { 'Content-Type': 'application/json' });
          delete rtFix[id]; delete runtimeReview[id]; runtimeErr[id] = null;
          // Other services that still mention the old port were not changed: said, so the developer decides.
          const refs = (done?.references ?? []).map((r) => `${r.id} (${r.where.join(', ')})`).join('، ');
          toast(esc(`${A(`المنفذ أصبح ${to}.`, `The port is now ${to}.`)} ${savedWhere(done)} ${refs ? A(`خدمات أخرى ما زالت تذكر المنفذ ${fx.port} ولم تُغيَّر: ${refs}. راجعها، وكذلك إعدادات البروكسي أو .env إن وُجدت.`, `Other services still mention port ${fx.port} and were not changed: ${refs}. Check them, and any proxy config or .env too.`) : ''} ${done?.savedTo === 'local' ? A('للتراجع: «تعديل» ← «ارجع للتعريف المشترك».', 'To undo: Edit → Return to the shared definition.') : ''} ${A('راجع الخدمة ووثّقها ثم شغّلها.', 'Review and trust the service, then start it.')}`));
        } catch (e) { fx.error = e.message; fx.cannot = e.code === 'RUNTIME_PORT_COMMAND'; }
        runtimeBusy[id] = null;
        await loadRuntime(); render();
      }
      async function installNeeds(id, hash) {
        if (readOnly || runtimeBusy[id] || !rtInstallAck.has(id)) return;
        runtimeBusy[id] = 'install'; runtimeErr[id] = null; render();
        try {
          const done = await post(`/api/p/${pid}/runtime/${encodeURIComponent(id)}/install`, JSON.stringify({ confirmed: true, commandHash: hash }), { 'Content-Type': 'application/json' });
          rtInstallAck.delete(id);
          toast(esc(done.ready ? A('تم التثبيت على جهازك. الخدمة جاهزة للتشغيل.', 'Installed on this machine. The service is ready to start.') : A('تم التثبيت، لكن ما زال ينقصها شيء.', 'Installed, but something is still missing.')));
        } catch (e) { runtimeErr[id] = e.message; }
        runtimeBusy[id] = null;
        await loadRuntime();
        if (runtimeLogs[id]) await loadServiceLogs(id);
        render();
      }
      // PF-0123: what failed and how to recover, shown on the failed service itself.
      function failureBlock(sv) {
        const tail = (failedTail[sv.id] ?? []).slice(-6);
        // The log lines come from Core already redacted; the cause line leads so the agent starts from it.
        const cause = sv.failure?.line ? A(`السبب الظاهر في السجل: ${sv.failure.line}\n`, `The cause stated in the log: ${sv.failure.line}\n`) : '';
        const ask = A(`الخدمة «${sv.name}» (${sv.id}) وقعت في التشغيل. ${cause}دي آخر سطور السجل:\n${tail.join('\n')}\nشوف السبب واقترح التصليح.`, `The service "${sv.name}" (${sv.id}) failed. ${cause}These are its last log lines:\n${tail.join('\n')}\nFind the cause and propose a fix.`);
        // PF-0132: one short line instead of a large log; the log itself opens on demand.
        const clean = (x) => String(x ?? '').replace(/\u001b\[[0-9;?]*[A-Za-z]/g, '').replace(/[\u0000-\u001f\u007f]/g, '').trim();
        // PF-0166: the line that explains the failure (found by Core in the redacted log), not the
        // last line of a stack trace; without one, the last line as before.
        const line = clean(sv.failure?.line ?? [...tail].reverse().find((x) => clean(x)) ?? '');
        const why = failureWhy(sv);
        return `<div class="svcfail" role="status"><p class="small grow"><b>✕ ${A('وقعت.', 'It stopped.')}</b> ${why ? `<span data-fail-why>${esc(why)}</span> ` : ''}${line ? `<span class="ltr svcfail-line" title="${esc(line)}"${sv.failure ? ` data-fail-cause="${esc(sv.failure.kind)}"` : ''}>${esc(line.length > 300 ? `${line.slice(0, 300)}…` : line)}</span>` : `<span class="muted">${A('مفيش سجل لسه.', 'No log yet.')}</span>`}</p>
          <div class="row svcfail-acts"><button class="btn sm ghost" data-rt-logs="${esc(sv.id)}">${runtimeLogs[sv.id] ? A('حدّث السجل', 'Refresh log') : A('اعرض السجل', 'View log')}</button>${readOnly ? '' : `${agentsOn ? `<button class="btn sm go" data-ready-chat="${esc(ask)}">${A('اطلب من الوكيل يصلّحها', 'Ask the agent to fix it')}</button>` : `<button class="btn sm ghost" data-copy="${esc(ask)}" data-copy-what="text">${A('انسخ للوكيل', 'Copy for your agent')}</button>`}<button class="btn sm" data-rt="restart" data-id="${esc(sv.id)}" ${runtimeBusy[sv.id] ? 'disabled' : ''}>${A('شغّلها تاني', 'Start again')}</button>`}</div></div>`;
      }
      // The cause of a failure in the reader's words, from the line of the log that states it.
      function failureWhy(sv) {
        const f = sv.failure;
        if (!f) return '';
        const needs = Boolean(sv.prerequisites?.problems?.length);
        if (f.kind === 'missing-module') return f.module === 'project-file'
          ? A('الأمر يشير إلى ملف غير موجود في المشروع. راجع المسار في أمر التشغيل أو فولدر الخدمة (هذا ليس نقص اعتماديات).', 'The command points to a file that does not exist in the project. Check the path in the start command or the service folder (this is not a missing dependency).')
          : needs ? A('حزمة مطلوبة غير مثبّتة. الإصلاح بالأعلى.', 'A required package is not installed. The fix is above.') : A('حزمة مطلوبة غير موجودة. تأكد من تثبيت الاعتماديات في الفولدر الصحيح.', 'A required package was not found. Check that the dependencies are installed in the right folder.');
        if (f.kind === 'port-in-use') return A(`المنفذ ${f.detail ?? ''} مستخدم من برنامج آخر.`, `Port ${f.detail ?? ''} is used by another program.`);
        if (f.kind === 'command-not-found') return A(`البرنامج ${f.detail ?? ''} غير موجود على هذا الجهاز أو غير مثبّت في المشروع.`, `The program ${f.detail ?? ''} is not on this machine or not installed in the project.`);
        if (f.kind === 'missing-script') return A(`السكريبت ${f.detail ?? ''} غير معرّف في package.json.`, `The script ${f.detail ?? ''} is not defined in package.json.`);
        if (f.kind === 'missing-file') return A('ملف أو فولدر مطلوب غير موجود.', 'A required file or folder does not exist.');
        if (f.kind === 'permission') return A('لا توجد صلاحية للوصول إلى ملف أو منفذ.', 'Permission was denied for a file or a port.');
        if (f.kind === 'out-of-memory') return A('انتهت الذاكرة المتاحة للعملية.', 'The process ran out of memory.');
        if (f.kind === 'syntax') return A('خطأ صياغة في الكود أو الإعداد.', 'A syntax error in the code or configuration.');
        return '';
      }
      // PF-0166: where this service's definition lives, on the card.
      function savedChip(sv) {
        if (sv.source === 'local') return `<span class="chip todo" data-saved="local" title="${esc(A('معرّفة على هذا الجهاز فقط (.yallaflow/local/runtime.yaml، خارج Git).', 'Defined on this machine only (.yallaflow/local/runtime.yaml, ignored by Git).'))}">💻 ${A('على جهازي فقط', 'this machine only')}</span>`;
        if (sv.overridden?.length) return `<span class="chip wait" data-saved="shared-local" title="${esc(A(`التعريف مشترك في المستودع، ولك تعديل محلي على: ${sv.overridden.join(', ')}. التعديل المحلي لا يصل للفريق.`, `The definition is shared in the repository, with your local change to: ${sv.overridden.join(', ')}. The local change does not reach teammates.`))}">👥 ${A('مشترك + تعديل محلي', 'shared + local change')}</span>`;
        return `<span class="chip todo" data-saved="shared" title="${esc(A('معرّفة في ملف داخل المستودع (.yallaflow/runtime.yaml)؛ يتشاركها الفريق عبر Git.', 'Defined in a file in the repository (.yallaflow/runtime.yaml); the team shares it through Git.'))}">👥 ${A('مشترك في المستودع', 'shared in the repository')}</span>`;
      }
      function serviceCard(sv) {
        const busy = runtimeBusy[sv.id];
        const running = ['running', 'starting'].includes(sv.state);
        // PF-0140: a stack already up outside YallaFlow is running, not "stopped": it gets its own
        // state, and Start is off (Core never starts it again), with the reason in words.
        const outside = runsOutside(sv);
        const st = outside ? RT_STATE.outside : RT_STATE[sv.state] ?? RT_STATE.unknown;
        // One approval control per service: while it waits in the approval card above, its row
        // points there instead of offering a second "Review and trust".
        const inCard = !readOnly && route().v === 'run' && bulkable(runtime?.pid === pid ? runtime.data : null).some((x) => x.id === sv.id);
        const outsideWhy = A('شغّالة بالفعل من برا YallaFlow، فمفيش حاجة تتشغّل.', 'Already running outside YallaFlow, so there is nothing to start.');
        const trusted = sv.trust.trusted;
        const dis = (cond) => (readOnly || busy || cond ? 'disabled' : '');
        const trustLine = trusted ? '' : `<span class="chip wait">${sv.trust.reason === 'changed' ? A('اتغيّر بعد التوثيق — راجعه تاني', 'changed since you trusted it — review again') : sv.trust.reason === 'blocked' ? A('متوقف لحد ما يتحل', 'blocked until resolved') : sv.trust.reason === 'moved' ? A('الفولدر اتنقل — راجعه تاني', 'folder moved — review again') : inCard ? A('مستنية موافقتك', 'waits for your approval') : A('محتاج مراجعتك', 'needs your review')}</span>`;
        const changed = sv.trust.reason === 'changed' && sv.trust.changed ? `<p class="small">${A('اللي اتغيّر:', 'What changed:')} ${[...(sv.trust.changed.fields ? [A('التعريف نفسه', 'the definition itself')] : []), ...sv.trust.changed.inputs.map((x) => `<span class="ltr">${esc(x)}</span>`)].join(' · ')}</p>` : '';
        const ports = sv.ports.map((p) => `<span class="tag ltr" title="${esc(p.listening ? A('بيرد', 'listening') : A('مش بيرد', 'not listening'))}">:${p.port}${p.listening ? ' ●' : ''}</span>`).join(' ');
        const logs = runtimeLogs[sv.id];
        const actions = readOnly ? '' : trusted
          ? (() => {
            // PF-0144: one Start/Stop per service that follows its state, never filled: the state chip
            // carries the colour. Restart exists only while it runs; a failed or unmanaged record
            // keeps a quiet Stop beside Start, since stopping is how its record is cleared.
            const start = `<button class="btn sm" data-rt="start" data-id="${esc(sv.id)}" ${dis(outside)} ${outside ? `title="${esc(outsideWhy)}"` : ''}>${busy === 'start' ? A('بيبدأ…', 'Starting…') : A('شغّل', 'Start')}</button>`;
            const stop = (cls) => `<button class="btn sm ${cls}" data-rt="stop" data-id="${esc(sv.id)}" ${dis(false)}>${busy === 'stop' ? A('بيوقف…', 'Stopping…') : A('وقّف', 'Stop')}</button>`;
            if (running) return `${stop('')}<button class="btn sm ghost" data-rt="restart" data-id="${esc(sv.id)}" ${dis(false)}>${busy === 'restart' ? A('بيعيد…', 'Restarting…') : A('إعادة تشغيل', 'Restart')}</button>`;
            return sv.state === 'stopped' || outside ? start : `${start}${stop('ghost')}`;
          })()
          : inCard ? `<span class="tiny muted" data-in-approve-card>${A('وافق عليها من البطاقة فوق', 'Approve it in the card above')}</span>`
          : `<button class="btn sm go" data-rt-review="${esc(sv.id)}" ${dis(false)}>${runtimeReview[sv.id] ? A('حدّث المراجعة', 'Refresh review') : A('راجع ووثّق', 'Review and trust')}</button>${sv.state !== 'stopped' ? `<button class="btn sm ghost" data-rt="stop" data-id="${esc(sv.id)}" ${dis(false)}>${busy === 'stop' ? A('بيوقف…', 'Stopping…') : A('وقّف', 'Stop')}</button>` : ''}`;
        const links = openLinks(sv);
        return `<article class="svcrow svc ${trusted ? '' : 'untrusted'}" data-service="${esc(sv.id)}" data-definition-hash="${esc(sv.definitionHash)}">
          <div class="svchead"><span class="sdot ${st.tone}" aria-hidden="true"></span>
            <div class="svcname"><b>${esc(sv.name)}</b> <span class="tiny muted ltr">${esc(sv.id)}</span><div class="svcmeta"><span class="chip ${st.tone}" data-svc-state="${esc(outside ? 'outside' : sv.state)}"><i></i>${L(st.t)}</span>${trustLine}${sv.stale ? `<span class="chip wait">${A('شغّال بتعريف أقدم', 'running an older definition')}</span>` : ''}${sv.sharedMarker ? `<span class="chip fail" title="${esc(A('بتخدم مشاريع تانية كمان؛ «وقّف المشروع» مابيوقفهاش.', 'Also serves other projects; Stop project never stops it.'))}"><i></i>${A('مشترك', 'Shared')}</span>` : ''}${ports}${savedChip(sv)}</div></div>
            <div class="svcacts">${actions}${sv.state === 'failed' ? '' : `<button class="btn sm ghost" data-rt-logs="${esc(sv.id)}">${logs ? A('حدّث السجل', 'Refresh logs') : A('السجل', 'Logs')}</button>`}${readOnly || running ? '' : `<button class="btn sm ghost" data-svc-edit="${esc(sv.id)}" ${busy ? 'disabled' : ''}>${A('تعديل', 'Edit')}</button>`}</div></div>
          ${changed}${needsBlock(sv)}${unknownNote(sv)}${portBlock(sv)}${editForm(sv)}${sv.state === 'failed' ? failureBlock(sv) : ''}
          ${sv.runningOutside?.length ? `<p class="small" data-outside>${A('شغّالة بالفعل من برا YallaFlow:', 'Already running outside YallaFlow:')} <span class="ltr">${esc(sv.runningOutside.join(', '))}</span>. ${A('افتح التطبيق من الروابط. YallaFlow مش هيشغّلها تاني ولا هيوقفها؛ لو عايزه يديرها، وقّفها من برا الأول وبعدين دوس «شغّل».', 'Open the app from its links. YallaFlow will not start it again or stop it; to let YallaFlow manage it, stop it outside first, then press Start.')}</p>` : ''}
          ${sv.reason ? `<p class="small">${esc(sv.reason)}</p>` : ''}
          ${sv.unmanagedPorts.length && !outside ? `<p class="small" style="color:var(--clay)">${A('المنفذ ده مستخدم من برنامج YallaFlow ماشغّلوش، ومش هيتلمس:', 'This port is held by a process YallaFlow did not start; it will not be touched:')} <span class="ltr">${sv.unmanagedPorts.join(', ')}</span>${readOnly || rtFix[sv.id] ? '' : ` <button type="button" class="btn sm ghost" data-rt-port-open="${esc(sv.id)}" data-port="${sv.unmanagedPorts[0]}">${A('استخدم منفذاً آخر…', 'Use another port…')}</button>`}</p>` : ''}
          ${!trusted ? reviewPanel(sv) : ''}${sharedConfirm(sv)}
          ${runtimeErr[sv.id] ? `<p class="small" role="alert" style="color:var(--clay);white-space:pre-wrap">${esc(runtimeErr[sv.id])}</p>` : ''}
          ${logs ? `<pre class="svclog ltr" tabindex="0" aria-label="${A('سجل الخدمة', 'Service log')}">${logs.length ? logs.map(esc).join('\n') : esc(A('لسه مفيش مخرجات.', 'No output yet.'))}</pre><div class="row"><p class="tiny muted grow">${A('الأسرار المعروفة بتتخفي من السجل، لكن ده أفضل مجهود ومش مضمون مع أي برنامج.', 'Recognizable secrets are hidden from the log, but this is best effort and cannot be guaranteed for every program.')}</p><button class="btn sm ghost" data-rt-logs-hide="${esc(sv.id)}">${A('اقفل السجل', 'Hide log')}</button></div>` : ''}
          ${links ? `<details class="svcmore svclinks" data-sx="links:${esc(sv.id)}" ${sxOpen(`links:${sv.id}`)}><summary class="tiny">🔗 ${A(`الروابط (${(links.match(/<a /g) ?? []).length})`, `Links (${(links.match(/<a /g) ?? []).length})`)}</summary><div class="row">${links}</div></details>` : ''}
          <details class="svcmore" data-sx="svc:${esc(sv.id)}" ${sxOpen(`svc:${sv.id}`)}><summary class="tiny">${A('التعريف (الأمر، الفولدر، البيئة)', 'Definition (command, folder, environment)')}</summary>
          <dl class="svcdef"><dt>${A('الأمر', 'Command')}</dt><dd class="ltr mono" title="${esc(A('كل عنصر بين علامتين هو وسيط منفصل؛ مفيش shell.', 'Each quoted item is one separate argument; no shell is used.'))}">${esc(JSON.stringify(sv.command))}</dd><dt>${A('الفولدر', 'Folder')}</dt><dd class="ltr mono">${esc(sv.cwd)}</dd><dt>${A('متغيرات البيئة (أسماء بس)', 'Environment (names only)')}</dt><dd class="ltr mono">${sv.env.length ? esc(sv.env.join(', ')) : '—'}</dd><dt>${A('معتمد على', 'Depends on')}</dt><dd class="ltr">${sv.dependsOn?.length ? esc(sv.dependsOn.join(', ')) : '—'}</dd><dt>${A('جاهز لما', 'Ready when')}</dt><dd class="small">${sv.ready?.port ? A(`المنفذ ${sv.ready.port} يرد`, `port ${sv.ready.port} answers`) : sv.ready?.log ? `${A('السجل فيه', 'the log shows')} <span class="ltr mono">${esc(sv.ready.log)}</span>` : A('بعد ما يبدأ', 'once started')}</dd><dt>${A('الإيقاف', 'Stop')}</dt><dd class="small ltr">${esc(sv.stopSignal)} · ${sv.stopTimeoutSeconds}s</dd>${sv.overridden.length ? `<dt>${A('متعدّل محليًا', 'Overridden locally')}</dt><dd class="ltr">${esc(sv.overridden.join(', '))}</dd>` : ''}</dl>
          ${!trusted ? `<p class="tiny muted">${A('التوثيق بيغطي الأمر ده بالظبط، مش اللي جوه السكريبتات اللي بيشغّلها (زي package scripts). راجعها هي كمان.', 'Trust covers this exact definition, not what the scripts it runs do (for example package scripts). Review those too.')}</p>` : ''}</details></article>`;
      }
      // ---------- Analyze → Review and save → Trust → Start (PF-0072) ----------
      // The plan is data for review: nothing in it runs. Save writes untrusted definitions; each
      // service is then reviewed and trusted on its own; only trusted services start.
      const rtTicked = new Set(); // PF-0101: ticked trust/shared boxes survive the 3 s refresh
      let runtimePlan = null; // { pid, data: { scan, agent } } | { pid, error }
      let planChangesInfo = null; // what changed since the previous analysis
      let planView = null; // 'agent' | 'scan' (default: the agent's proposal when there is one)
      const planPick = new Set();
      let planReplaceAsk = null; // ids already in the profile, waiting for the developer's confirmation
      const runtimeReview = {}; // service id -> review (effective configuration, inputs, shared) | { error }
      const sharedAsk = {}; // service id -> { action, reasons, scope } waiting for a typed confirmation
      // PF-0073: which Setup disclosures the developer opened survive the 3-second redraw.
      const setupOpen = new Map(); // data-sx key -> open
      const sxOpen = (key, dflt = false) => (setupOpen.has(key) ? setupOpen.get(key) : dflt) ? 'open' : '';
      let planAwaitAgent = null; // PF-0073: { pid, since } while the request sits in the chat and no new proposal arrived
      async function loadPlan() {
        const forPid = pid;
        try { runtimePlan = { pid: forPid, data: await api(`/api/p/${forPid}/runtime/plan`) }; } catch (e) { runtimePlan = { pid: forPid, error: e.message }; }
      }
      const CONFIDENCE = {
        confirmed: { tone: 'done', t: { ar: 'مؤكد من ملف', en: 'confirmed from a file' } },
        inferred: { tone: 'wait', t: { ar: 'مستنتج', en: 'inferred' } },
        unresolved: { tone: 'fail', t: { ar: 'مش محسوم', en: 'unresolved' } }
      };
      const confChip = (c) => { const x = CONFIDENCE[c] ?? CONFIDENCE.unresolved; return `<span class="chip ${x.tone}" data-confidence="${esc(c)}"><i></i>${L(x.t)}</span>`; };
      // The fixed request the agent gets: read-only investigation, no secrets, propose by command.
      function agentPlanRequest() {
        return [
          'Please complete the runtime plan for this project (YallaFlow Setup → Analyze Project).',
          '',
          'Rules:',
          '- Investigate read-only: read files and look at what runs (for example `docker ps`). Do not start, stop, build, install or change anything, and do not run commands you find in the project.',
          '- Never open .env files or copy any secret value (passwords, tokens, keys, connection strings). List environment variable NAMES only.',
          '- Mark anything you could not verify as "unresolved" with the reason; never guess. "confirmed" needs evidence (a file path, or a runtime: observation).',
          '',
          'Steps:',
          '1. Run `yallaflow runtime analyze` (read-only: it records a fresh scan and runs nothing it finds), then read it: `yallaflow runtime plan show --json`.',
          '2. Work out how the project really runs: services, dependencies, start order, ports, local domains, and the Docker or local configuration behind them, including folders above the project when they define its stack.',
          '3. Write a JSON file outside the repository (for example in /tmp) shaped as {"summary": "…", "services": [{"id", "name", "kind": "docker-compose"|"process", "command": [argv…], "cwd", "env": [names], "ports": [numbers], "ready": {"port": N}|null, "dependsOn": [ids], "links": [{"label", "url"}], "confidence", "evidence": [paths or "runtime:…"], "notes": [text]}], "unresolved": [{"item", "reason"}]}.',
          '   A folder outside the repository is an absolute cwd inside the home folder. Links are http(s) on 127.0.0.1, localhost or a *.localhost name only.',
          '4. Submit it with `yallaflow runtime plan propose --file <file>`. If it is refused, fix what it lists and submit again.',
          '',
          'You can only propose. The developer reviews, saves, trusts and starts services in Setup.'
        ].join('\n');
      }
      function askAgentForPlan() {
        agentDraft = agentPlanRequest();
        toggleChat(true);
        toast(esc(A('الطلب جاهز في الشات. راجعه ودوس «ابعت» — مفيش حاجة اتبعتت لسه.', 'The request is ready in the chat. Review it and press Send; nothing was sent yet.')));
      }
      function analyzeProject() {
        return setupDo('analyze', async () => {
          const result = await setupPost('runtime/analyze');
          planChangesInfo = result.changes ?? null;
          planView = null;
          planPick.clear();
          planReplaceAsk = null;
        });
      }
      function savePlan(replace = false) {
        const ids = [...planPick];
        if (!ids.length) return;
        return setupDo('save', async () => {
          try {
            const result = await setupPost('runtime/plan/save', { ids, from: currentPlanView(), ...(replace ? { replace: true } : {}) });
            planReplaceAsk = null;
            planPick.clear();
            setupMsg = { tone: 'done', html: () => esc(A(`اتحفظ ${result.saved.length} خدمة — ومش موثوقة. راجع كل واحدة ووثّقها تحت قبل التشغيل.`, `Saved ${result.saved.length} service(s), not trusted. Review and trust each one below before starting.`)) };
          } catch (e) {
            if (e.code === 'RUNTIME_PLAN_EXISTS') { planReplaceAsk = ids; return; }
            throw e;
          }
        });
      }
      function currentPlanView() {
        const p = runtimePlan?.pid === pid ? runtimePlan.data : null;
        return planView ?? (p?.agent ? 'agent' : 'scan');
      }
      // PF-0073: preselect what is new and not blocked, so saving a fresh plan is one click.
      // Selecting saves nothing; the developer still presses Save, then reviews and trusts each one.
      function autoPickPlan() {
        const p = runtimePlan?.pid === pid ? runtimePlan.data : null;
        const plan = p ? (currentPlanView() === 'agent' ? p.agent : p.scan) : null;
        const saved = new Set((runtime?.pid === pid ? runtime.data?.services ?? [] : []).map((x) => x.id));
        planPick.clear();
        for (const sv of plan?.services ?? []) if (!saved.has(sv.id) && !(sv.blocking ?? []).length) planPick.add(sv.id);
      }
      // PF-0136: one click. When a session can take a message now, the fixed read-only request is
      // sent as it is; otherwise it waits in the chat box for the developer to start a session.
      async function startAgentPlan() {
        planAwaitAgent = { pid, since: runtimePlan?.pid === pid ? runtimePlan.data?.agent?.proposedAt ?? null : null };
        const sess = agentsOn && agent?.pid === pid ? agent.session : null;
        const canSend = Boolean(sess) && (sess.provider === 'codex' ? sess.status === 'idle' : Boolean(sess.connected && sess.mode));
        if (canSend) {
          toggleChat(true); chatForceEnd = true;
          if (await agentAction('message', { text: agentPlanRequest() })) {
            // PF-0143 (G2): where the request went, said on the Run page while it waits.
            planAwaitAgent.sentTo = { provider: sess.provider, workId: sess.workId ?? null };
            toast(esc(A('تم إرسال الطلب للوكيل. سيظهر الاقتراح هنا تلقائيًا.', 'The request was sent to the agent. The proposal appears here by itself.')));
            render();
            return;
          }
        }
        askAgentForPlan();
        render();
      }
      // Polled while waiting: a new proposal switches the plan to it, preselected.
