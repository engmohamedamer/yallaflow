#   yallaflow activate <work-id>
#   yallaflow request --help
#   yallaflow intake <file> [<file> ...] [--title TITLE]
#   yallaflow intake add <work-id> <file> [<file> ...] [--reason TEXT]
#   yallaflow intake ticket <payload-file|ticket-ref> [--provider github|jira|azure-devops] [--work <work-id>] [--reason TEXT] [--fetch [--attachments]] [--attachment <file>]... [--title TITLE] [--max-comments N]
#   yallaflow source --help
#   yallaflow route <work-id> --type TYPE --scope SCOPE --confidence LEVEL --reason REASON [--title TITLE]
#   yallaflow baseline --help
#   yallaflow guide [work-id]
#   yallaflow ready [work-id]
#   yallaflow skill <skill-id> [--work <work-id>]
