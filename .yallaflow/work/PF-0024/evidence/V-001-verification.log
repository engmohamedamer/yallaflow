#   yallaflow new --help
#   yallaflow history --help
#   yallaflow console [--port N] [--no-open] [--project DIR]... [--read-only] [--agents]
#   yallaflow agents detect
#   yallaflow work show <work-id> [--json]
#   yallaflow work hold|resume|close <work-id> ...  (lifecycle: on hold, closed without delivery)
#   yallaflow resume [work-id]
