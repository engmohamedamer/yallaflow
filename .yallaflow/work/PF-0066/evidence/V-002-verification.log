#   yallaflow qc --help
#   yallaflow demo --help
#   yallaflow shared --help
#   yallaflow status
#   yallaflow snapshot [--json]
#   yallaflow overview [--json]
#   yallaflow runtime --help
#   yallaflow new --help
#   yallaflow history --help
#   yallaflow console [--port N] [--no-open] [--project DIR]... [--read-only] [--agents]
