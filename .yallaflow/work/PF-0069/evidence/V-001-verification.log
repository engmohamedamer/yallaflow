#   yallaflow activate <work-id>
#   yallaflow request --help
#   yallaflow intake <file> [<file> ...] [--title TITLE]
#   yallaflow intake add <work-id> <file> [<file> ...] [--reason TEXT] [--before-start]
#   yallaflow intake ticket <payload-file|ticket-ref> [--provider github|jira|azure-devops] [--work <work-id>] [--reason TEXT] [--fetch [--attachments]] [--attachment <file>]... [--title TITLE] [--max-comments N]
#   yallaflow source --help
#   yallaflow route <work-id> --type TYPE --scope SCOPE --confidence LEVEL --reason REASON [--title TITLE]
#   yallaflow baseline --help
#   yallaflow guide [work-id]
#   yallaflow ready [work-id]
#   yallaflow skill <skill-id> [--work <work-id>]
#   yallaflow checkpoint --help
#   yallaflow question --help
#   yallaflow knowledge --help
#   yallaflow requirement --help
#   yallaflow convergence --help
#   yallaflow impact --help
#   yallaflow context --help
#   yallaflow upgrade status|plan
#   yallaflow brief
#   yallaflow inspect
#   yallaflow limitation --help
#   yallaflow agent --help
#   yallaflow decompose --help
#   yallaflow progress <parent-id>
#   yallaflow next <parent-id>
#   yallaflow approve <work-id> --stage GATE [--note TEXT]
#   yallaflow feedback <work-id> --stage GATE --changes-requested [--note TEXT]
#   yallaflow handoff [work-id]
#   yallaflow feature <title> --scope SCOPE
#   yallaflow bug <title> --scope SCOPE
#   yallaflow investigate <title> --scope SCOPE
#   yallaflow change <title> --scope SCOPE
#   yallaflow refactor <title> --scope SCOPE
#   yallaflow release <title> --scope SCOPE
#   yallaflow purpose --help
#   yallaflow finish [work-id] [--verbose]
#   yallaflow qc --help
#   yallaflow demo --help
#   yallaflow shared --help
#   yallaflow status
#   yallaflow snapshot [--json]
#   yallaflow overview [--json]
#   yallaflow runtime --help
#   yallaflow new --help
#   yallaflow history --help
#   yallaflow console [--port N] [--no-open] [--project DIR]... [--read-only] [--agents]
#   yallaflow agents detect
#   yallaflow work show <work-id> [--json]
#   yallaflow work hold|resume|close <work-id> ...  (lifecycle: on hold, closed without delivery)
#   yallaflow resume [work-id]
#   yallaflow doctor [--clear-lock]
#   yallaflow advance [work-id]
#   yallaflow verify [work-id] -- <executable> [args...]
#   yallaflow verify [work-id] --shell "<command>"
#   yallaflow verify [work-id] --script <path>
#   yallaflow verify list [work-id]
#   yallaflow reopen <work-id> --to implementation|verification|review --reason REASON
