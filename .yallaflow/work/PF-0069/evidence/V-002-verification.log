#   yallaflow source --help
#   yallaflow route <work-id> --type TYPE --scope SCOPE --confidence LEVEL --reason REASON [--title TITLE]
#   yallaflow baseline --help
#   yallaflow guide [work-id]
#   yallaflow ready [work-id]
#   yallaflow skill <skill-id> [--work <work-id>]
#   yallaflow checkpoint --help
#   yallaflow question --help
#   yallaflow knowledge --help
#   yallaflow requirement --help
#   yallaflow convergence --help
#   yallaflow impact --help
#   yallaflow context --help
#   yallaflow upgrade status|plan
#   yallaflow brief
#   yallaflow inspect
#   yallaflow limitation --help
#   yallaflow agent --help
#   yallaflow decompose --help
#   yallaflow progress <parent-id>
#   yallaflow next <parent-id>
#   yallaflow approve <work-id> --stage GATE [--note TEXT]
#   yallaflow feedback <work-id> --stage GATE --changes-requested [--note TEXT]
#   yallaflow handoff [work-id]
#   yallaflow feature <title> --scope SCOPE
#   yallaflow bug <title> --scope SCOPE
#   yallaflow investigate <title> --scope SCOPE
#   yallaflow change <title> --scope SCOPE
#   yallaflow refactor <title> --scope SCOPE
#   yallaflow release <title> --scope SCOPE
#   yallaflow purpose --help
