#   yallaflow work show <work-id> [--json]
#   yallaflow work hold|resume|close <work-id> ...  (lifecycle: on hold, closed without delivery)
#   yallaflow resume [work-id]
#   yallaflow doctor [--clear-lock]
#   yallaflow advance [work-id]
#   yallaflow verify [work-id] -- <executable> [args...]
#   yallaflow verify [work-id] --shell "<command>"
#   yallaflow verify [work-id] --script <path>
